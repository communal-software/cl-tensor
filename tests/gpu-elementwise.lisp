(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu)

(defparameter *device-dtypes* '(:f32 :f16 :bf16 :s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64))
(defparameter *numeric-device-dtypes* '(:f32 :s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64))

(test all-device-storage-types-round-trip
  (let ((device (make-instance 'mock-device)))
    (dolist (dtype *device-dtypes*)
      (let* ((cpu (ct:make-tensor '(2 3) :dtype dtype))
             (values (ct:tensor-storage cpu)))
        (dotimes (i 6) (setf (aref values i) (if (eq dtype :f32) (float i 1f0) i)))
        (tg:with-device-tensor (input (tg:to-device (ct:transpose cpu) :device device))
          (is (eq dtype (ct:tensor-dtype input)))
          (is (eq dtype (ct:storage-dtype (ct:tensor-storage input))))
          (is (equal (cl-tensor/tests::tensor-values (ct:transpose cpu))
                     (cl-tensor/tests::tensor-values (tg:from-device input)))))
        (tg:with-device-tensor (zero (tg:make-device-tensor '(0) :dtype dtype :device device))
          (is (eq dtype (ct:tensor-dtype zero))))))
    (is (= (allocations device) (frees device)))))

(test elementwise-dispatch-types-scalars-and-placement
  (let ((device (make-instance 'mock-device))
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (dolist (dtype *numeric-device-dtypes*)
      (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :dtype dtype :device device))
        (dolist (operation '(ct:add ct:subtract ct:multiply ct:min ct:max))
          (tg:with-device-tensor (result (funcall operation input 1))
            (is (eq dtype (ct:tensor-dtype result))))
          (tg:with-device-tensor (result (funcall operation 1 input))
            (is (equalp #(2 3) (ct:tensor-shape result)))))
        (dolist (operation '(ct:negate ct:abs))
          (tg:with-device-tensor (result (funcall operation input))
            (is (eq dtype (ct:tensor-dtype result)))))
        (tg:with-device-tensor (mask (ct:compare :gt input 1))
          (is (eq :u8 (ct:tensor-dtype mask))))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (dolist (operation '(ct:divide ct:clamp))
        (tg:with-device-tensor (result (if (eq operation 'ct:clamp)
                                           (ct:clamp input 0 2) (ct:divide input 2)))
          (is (eq :f32 (ct:tensor-dtype result)))))
      (dolist (operation '(ct:sqrt ct:reciprocal ct:exp ct:log ct:sin ct:cos ct:tanh ct:sigmoid ct:silu ct:gelu))
        (tg:with-device-tensor (result (funcall operation input))
          (is (eq :f32 (ct:tensor-dtype result))))))
    (tg:with-device-tensor (mask (tg:make-device-tensor '(2 3) :dtype :u8 :device device))
      (tg:with-device-tensor (selected (ct:select mask 7 2 :dtype :s16))
        (is (eq :s16 (ct:tensor-dtype selected))))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2 3) :dtype :s32 :device device))
        (is (eq out (ct:select! out mask 1 2)))))
    (tg:with-device-tensor (out (tg:make-device-tensor nil :device device))
      (is (eq out (ct:add! out 1 2))))
    (tg:with-device-tensor (out (tg:make-device-tensor nil :dtype :u8 :device device))
      (is (eq out (ct:compare! out :lt 1 2))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test conversion-dispatch-pairs-and-empty-validation
  (let ((device (make-instance 'mock-device)) (other (make-instance 'mock-device)))
    (dolist (source *device-dtypes*)
      (tg:with-device-tensor (input (tg:make-device-tensor '(0 3) :dtype source :device device))
        (dolist (target *device-dtypes*)
          (if (and (or (member source '(:f16 :bf16)) (member target '(:f16 :bf16)))
                   (not (and (member source '(:f16 :bf16 :f32)) (member target '(:f16 :bf16 :f32)))))
              (signals error (ct:astype input target))
              (tg:with-device-tensor (result (ct:astype input target :rounding :floor))
                (is (eq target (ct:tensor-dtype result)))
                (is (equalp #(0 3) (ct:tensor-shape result))))))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(0 3) :device device))
      (tg:with-device-tensor (foreign (tg:make-device-tensor '(0 3) :device other))
        (dolist (thunk (list (lambda () (ct:add input foreign))
                             (lambda () (ct:add input (ct:zeros '(0 3))))
                             (lambda () (ct:add! (ct:zeros '(0 3)) input 1))
                             (lambda () (ct:astype input :f64))
                             (lambda () (ct:astype input :s8 :rounding :bad))
                             (lambda () (ct:select input 1 2 :dtype :f32))))
          (signals error (funcall thunk))))
      (tg:with-device-tensor (result (ct:dequantize input))
        (is (eq :f32 (ct:tensor-dtype result)))))
    (tg:with-device-tensor (half (tg:make-device-tensor '(0) :dtype :f16 :device device))
      (signals error (ct:add half half)))
    (is (zerop (launches device)))
    (is (= (allocations device) (frees device)))
    (is (= (allocations other) (frees other)))))

(test elementwise-failure-staging-and-cleanup
  (let ((device (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:to-device (ct:ones '(3)) :device device))
      (tg:with-device-tensor (out (tg:to-device (ct:full '(3) 77) :device device))
        (dolist (failure '(:launch :wait))
          (setf (fail-launch device) (eq failure :launch) (fail-wait device) (eq failure :wait))
          (signals error (ct:add! out input 2))
          (signals error (ct:astype input :s8))
          (is (= 2 (- (allocations device) (frees device))))
          (setf (fail-launch device) nil (fail-wait device) nil)
          (is (equal '(77f0 77f0 77f0) (cl-tensor/tests::tensor-values (tg:from-device out)))))))
    (tg:with-device-tensor (out (tg:make-device-tensor nil :device device))
      (setf (fail-wait device) t)
      (signals error (ct:add! out 1 2))
      (is (= 1 (- (allocations device) (frees device))))
      (setf (fail-wait device) nil))
    (is (= (allocations device) (frees device)))))

(test elementwise-validation-precedes-launch-and-allocation
  (let ((device (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (tg:with-device-tensor (integer (tg:make-device-tensor '(2 3) :dtype :s32 :device device))
        (let ((before (allocations device)))
          (dolist (thunk (list (lambda () (ct:add input integer))
                               (lambda () (ct:exp integer))
                               (lambda () (ct:add! integer input 1))
                               (lambda () (ct:add! (ct:reshape input '(6)) input 1))
                               (lambda () (ct:add! (ct:make-tensor-view (ct:tensor-storage input) '(2 3)
                                                                        :strides '(0 1)) input 1))
                               (lambda () (ct:select (ct:make-tensor-view (ct:tensor-storage integer) '(2 3)) 1 2))
                               (lambda () (ct:compare :bad input 1))))
            (signals error (funcall thunk)))
          (is (= before (allocations device))))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(3) :device device))
      (tg:free-device-tensor input)
      (signals error (ct:add input 1))
      (signals error (ct:astype input :s8)))
    (is (zerop (launches device)))
    (is (= (allocations device) (frees device)))))
