(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu)

(test device-dispatch-does-not-download-or-use-cpu-executor
  (let ((device (make-instance 'mock-device))
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (dolist (operation '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax ct:softmax ct:rmsnorm))
        (tg:with-device-tensor (result (funcall operation input :axis #()))
          (is (typep (ct:tensor-storage result) 'gpu:gpu-array))
          (is (equalp #(2 3) (ct:tensor-shape result)))
          (is (eq (if (member operation '(ct:argmin ct:argmax)) :s64 :f32) (ct:tensor-dtype result)))))
      (tg:with-device-tensor (copy (ct:copy-tensor input))
        (is (not (eq (ct:tensor-storage copy) (ct:tensor-storage input)))))
      (tg:with-device-tensor (copy (ct:reshape (ct:transpose input) '(6)))
        (is (typep (ct:tensor-storage copy) 'gpu:gpu-array)))
      (is (zerop (downloads device)))
      (is (plusp (launches device)))
      (is (plusp (waits device))))
    (is (= (allocations device) (frees device)))))

(test invalid-gpu-calls-do-not-launch
  (let ((device (make-instance 'mock-device)) (other (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2) :device device))
        (tg:with-device-tensor (weights (tg:make-device-tensor '(3) :device other))
          (dolist (thunk (list (lambda () (ct:sum input :accumulate :f64))
                              (lambda () (ct:softmax input :accumulate :f64))
                              (lambda () (ct:sum input :axis 3))
                              (lambda () (ct:sum input :axis '(1 -1)))
                              (lambda () (ct:sum! out input))
                              (lambda () (ct:sum! (ct:zeros '(2)) input :axis 1))
                              (lambda () (ct:rmsnorm input :weights (ct:ones '(3))))
                              (lambda () (ct:rmsnorm input :weights weights))
                              (lambda () (ct:rmsnorm input :weights #C(1 2)))
                              (lambda () (ct:rmsnorm input :epsilon -1))
                              (lambda () (ct:astype input :f64))
                              (lambda () (ct:sum! out (ct:ones '(2 3)) :axis 1))))
            (signals error (funcall thunk)))))
      (tg:with-device-tensor (indices (tg:make-device-tensor '(3) :dtype :s64 :device device))
        (signals error (ct:sum indices)))
      (is (zerop (launches device))))
    (is (= (allocations device) (frees device)))
    (is (= (allocations other) (frees other)))))

(test failures-release-scratch-before-destination-copy
  (let ((device (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2) :device device))
        (setf (fail-launch device) t)
        (signals error (ct:sum! out input :axis 1))
        (is (= 1 (launches device)))
        (is (= 2 (- (allocations device) (frees device))))
        (setf (fail-launch device) nil (fail-wait device) t)
        (signals error (ct:sum! out input :axis 1))
        (is (= 2 (launches device)))
        (is (= 2 (- (allocations device) (frees device))))
        (setf (fail-wait device) nil)
        (setf (fail-launch device) t)
        (signals error (ct:copy-tensor input))
        (is (= 2 (- (allocations device) (frees device))))))
    (setf (fail-launch device) nil (fail-wait device) t)
    (signals error (tg:make-device-tensor '(2) :device device))
    (signals error (tg:to-device (ct:ones '(2)) :device device))
    (is (= (allocations device) (frees device)))))

(defclass matmul-mock-device (mock-device)
  ((products :initform nil :accessor products)
   (fail-product :initform nil :accessor fail-product)))

(defmethod gpu:device-gemm :before ((device matmul-mock-device) m n k alpha a b beta c count)
  (push (list m n k alpha a b beta c count) (products device))
  (when (eql (fail-product device) (length (products device)))
    (error "Injected later batch failure")))

(test device-matmul-dispatch-and-batch-runs
  (let ((device (make-instance 'matmul-mock-device))
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (dolist (case '(((3) (3) () 1 1)
                    ((2 3) (3) (2) 1 1)
                    ((3) (3 4) (4) 1 1)
                    ((2 3) (3 4) (2 4) 1 1)
                    ((5 2 3) (3 4) (5 2 4) 1 5)
                    ((2 1 2 3) (1 3 3 4) (2 3 2 4) 2 3)))
      (destructuring-bind (as bs shape calls count) case
        (tg:with-device-tensor (a (tg:make-device-tensor as :device device))
          (tg:with-device-tensor (b (tg:make-device-tensor bs :device device))
            (setf (products device) nil)
            (tg:with-device-tensor (result (ct:matmul a b))
              (is (equalp (coerce shape 'vector) (ct:tensor-shape result)))
              (is (eq :f32 (ct:tensor-dtype result)))
              (is (eq device (gpu:gpu-array-device (ct:tensor-storage result))))
              (is (not (eq (ct:tensor-storage a) (ct:tensor-storage result))))
              (is (= calls (length (products device))))
              (is (every (lambda (product) (= count (ninth product))) (products device))))))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test device-matmul-window-and-signed-strides
  (let ((device (make-instance 'matmul-mock-device)))
    (tg:with-device-tensor (base (tg:make-device-tensor '(40) :device device))
      (let* ((window (gpu:make-gpu-array-view (ct:tensor-storage base) 30 :offset 3))
             (a (ct:make-tensor-view window '(2 3) :strides '(0 -2) :offset 7))
             (b (ct:make-tensor-view window '(3 2) :strides '(4 1) :offset 10)))
        (tg:with-device-tensor (result (ct:matmul a b))
          (is (equalp #(2 2) (ct:tensor-shape result)))
          (let* ((call (first (products device))) (av (fifth call)) (bv (sixth call)))
            (is (= 10 (second av)))
            (is (= 0 (third av)))
            (is (= -2 (fourth av)))
            (is (= 13 (second bv)))))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test device-matmul-validation-and-empty-results
  (let ((device (make-instance 'matmul-mock-device)) (other (make-instance 'mock-device)))
    (tg:with-device-tensor (a (tg:make-device-tensor '(2 2) :device device))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2 2) :device device))
        (tg:with-device-tensor (foreign (tg:make-device-tensor '(2 2) :device other))
          (tg:with-device-tensor (integer (tg:make-device-tensor '(2 2) :dtype :s64 :device device))
            (dolist (thunk (list (lambda () (ct:matmul a (ct:ones '(2 2))))
                                (lambda () (ct:matmul (ct:ones '(2 2)) a))
                                (lambda () (ct:matmul a foreign))
                                (lambda () (ct:matmul a integer))
                                (lambda () (ct:matmul (ct:make-tensor-view (ct:tensor-storage a) nil) a))
                                (lambda () (ct:matmul! integer a a))
                                (lambda () (ct:matmul! (ct:zeros '(2 2)) a a))
                                (lambda () (ct:matmul! foreign a a))
                                (lambda () (ct:matmul! out (ct:ones '(2 2)) (ct:ones '(2 2))))
                                (lambda () (ct:matmul a (ct:reshape a '(4))))
                                (lambda () (ct:matmul! (ct:reshape out '(4)) a a))
                                (lambda () (ct:matmul! (ct:make-tensor-view (ct:tensor-storage out)
                                                                          '(2 2) :strides '(0 1)) a a))))
              (signals error (funcall thunk)))))))
    (dolist (case '(((0 3) (3 2)) ((2 0) (0 3)) ((0) (0)) ((0 2 3) (3 4))))
      (destructuring-bind (as bs) case
        (tg:with-device-tensor (a (tg:make-device-tensor as :device device))
          (tg:with-device-tensor (b (tg:make-device-tensor bs :device device))
            (tg:with-device-tensor (result (ct:matmul a b))
              (is (equalp (ct:tensor-shape (ct:matmul (ct:zeros as) (ct:zeros bs)))
                          (ct:tensor-shape result))))))))
    (is (null (products device)))
    (is (zerop (launches device)))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))
    (is (= (allocations other) (frees other)))))

(test device-matmul-failures-preserve-destination-and-release-scratch
  (let ((device (make-instance 'matmul-mock-device)))
    (tg:with-device-tensor (a (tg:to-device (ct:ones '(2 2)) :device device))
      (tg:with-device-tensor (out (tg:to-device (ct:full '(2 2) 77) :device device))
        (dolist (failure '(:launch :wait))
          (setf (fail-launch device) (eq failure :launch)
                (fail-wait device) (eq failure :wait))
          (signals error (ct:matmul! out a a))
          (signals error (ct:matmul a a))
          (is (= 2 (- (allocations device) (frees device))))
          (setf (fail-launch device) nil (fail-wait device) nil)
          (is (equal '(77.0 77.0 77.0 77.0) (cl-tensor/tests::tensor-values (tg:from-device out)))))))
    (is (= (allocations device) (frees device)))))

(test device-matmul-later-batch-failure-and-freed-storage
  (let ((device (make-instance 'matmul-mock-device)))
    (tg:with-device-tensor (a (tg:make-device-tensor '(2 1 2 3) :device device))
      (tg:with-device-tensor (b (tg:make-device-tensor '(1 3 3 2) :device device))
        (tg:with-device-tensor (out (tg:to-device (ct:full '(2 3 2 2) 77) :device device))
          (setf (fail-product device) 2)
          (signals error (ct:matmul! out a b))
          (is (= 2 (length (products device))))
          (is (= 3 (- (allocations device) (frees device))))
          (is (every (lambda (value) (= 77 value))
                     (cl-tensor/tests::tensor-values (tg:from-device out)))))))
    (setf (products device) nil (fail-product device) nil)
    (let ((a (tg:make-device-tensor '(2 2) :device device)))
      (tg:free-device-tensor a)
      (signals error (ct:matmul a a)))
    (is (null (products device)))
    (is (= (allocations device) (frees device)))))

(test device-matmul-dimension-limits-precede-allocation
  (let ((device (make-instance 'matmul-mock-device)))
    (tg:with-device-tensor (base (tg:make-device-tensor '(1) :device device))
      (let ((a (ct:make-tensor-view (ct:tensor-storage base) '(1073741824 1) :strides '(0 0)))
            (b (ct:reshape base '(1 1)))
            (before (allocations device)))
        (signals error (ct:matmul a b))
        (is (= before (allocations device)))
        (is (null (products device)))))
    (is (= (allocations device) (frees device)))))
