(in-package #:cl-tensor/tests)
(in-suite :cl-tensor)

(defun reversed-range-executor (count callback)
  (loop for end = count then start while (plusp end)
        for start = (max 0 (- end 2)) do (funcall callback start end)))

(defstruct test-pool
  (lock (bt:make-lock "tensor test pool"))
  (wake (bt:make-condition-variable)) (done (bt:make-condition-variable))
  threads job errors (generation 0) (finished 0) stopped)

(defun test-pool-worker (pool id)
  (let ((seen 0))
    (loop
      (let ((job
              (bt:with-lock-held ((test-pool-lock pool))
                (loop while (and (not (test-pool-stopped pool)) (= seen (test-pool-generation pool)))
                      do (bt:condition-wait (test-pool-wake pool) (test-pool-lock pool)))
                (when (test-pool-stopped pool) (return-from test-pool-worker))
                (setf seen (test-pool-generation pool))
                (test-pool-job pool))))
        (handler-case (funcall job id)
          (error (condition) (setf (aref (test-pool-errors pool) id) condition)))
        (bt:with-lock-held ((test-pool-lock pool))
          (incf (test-pool-finished pool))
          (bt:condition-notify (test-pool-done pool)))))))

(defun make-threaded-test-executor (workers)
  (let ((pool (make-test-pool :errors (make-array workers :initial-element nil))))
    (dotimes (id workers)
      (let ((id id))
        (push (bt:make-thread (lambda () (test-pool-worker pool id)) :name "tensor test worker")
              (test-pool-threads pool))))
    (values
     (lambda (count callback)
       (bt:with-lock-held ((test-pool-lock pool))
         (fill (test-pool-errors pool) nil)
         (setf (test-pool-finished pool) 0
               (test-pool-job pool)
               (lambda (id)
                 (funcall callback (floor (* count id) workers) (floor (* count (1+ id)) workers))))
         (incf (test-pool-generation pool))
         (dotimes (id workers) (bt:condition-notify (test-pool-wake pool)))
         (loop until (= (test-pool-finished pool) workers)
               do (bt:condition-wait (test-pool-done pool) (test-pool-lock pool)))
         (let ((condition (find-if #'identity (test-pool-errors pool))))
           (when condition (error condition)))))
     (lambda ()
       (bt:with-lock-held ((test-pool-lock pool))
         (setf (test-pool-stopped pool) t)
         (dotimes (id workers) (bt:condition-notify (test-pool-wake pool))))
       (mapc #'bt:join-thread (test-pool-threads pool))))))

(defun check-executed-operations (executor)
  (let ((ct:*executor* executor))
    (dolist (dtype '(:f32 :f64))
      (dolist (shapes '(((5 4) (4 3)) ((5 4) (4)) ((4) (4 5)) ((4) (4))
                       ((2 1 3 4) (1 2 4 3)) ((4) (2 4 5)) ((2 5 4) (4))))
        (let* ((a (ct:reshape (ct:arange (reduce #'* (first shapes)) :dtype dtype) (first shapes)))
               (b (ct:reshape (ct:arange (reduce #'* (second shapes)) :dtype dtype) (second shapes)))
               (shape (nth-value 0 (reference-matmul a b)))
               (out (ct:transpose (ct:zeros (reverse shape) :dtype dtype))))
          (check-matmul a b)
          (check-matmul a b out)))
      (let* ((original (ct:reshape (ct:arange 1 25 :dtype dtype) '(2 3 4)))
             (a (ct:transpose original)))
        (dolist (axis '(nil 0 -1 (0 2) #()))
          (dolist (operation '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax))
            (let* ((expected (let ((ct:*executor* nil)) (funcall operation a :axis axis)))
                   (out (ct:zeros (ct:tensor-shape expected) :dtype (ct:tensor-dtype expected)))
                   (out-function (symbol-function (find-symbol (format nil "~A!" operation) :cl-tensor))))
              (check-fusion-values (funcall operation a :axis axis) (tensor-values expected))
              (funcall out-function out a :axis axis)
              (check-fusion-values out (tensor-values expected))))
          (check-fusion-values (ct:sum a :axis axis :accumulate :f64)
                               (tensor-values (let ((ct:*executor* nil)) (ct:sum a :axis axis :accumulate :f64))))
          (check-fusion-values (fused-test-softmax a :axis axis)
                               (tensor-values (let ((ct:*executor* nil)) (fused-test-softmax a :axis axis))))
          (check-fusion-values (ct:fuse (ct:sum (* a a)) :axis axis)
                               (tensor-values (let ((ct:*executor* nil)) (ct:fuse (ct:sum (* a a)) :axis axis))))))
      (let* ((a (ct:reshape (ct:arange 9 :dtype dtype) '(3 3))) (b (ct:eye 3 :dtype dtype))
             (expected (tensor-values a)))
        (ct:matmul! a a b)
        (check-fusion-values a expected)
        (let ((out (ct:slice a :selectors '(:all 0))))
          (ct:sum! out a :axis -1)
          (check-fusion-values out '(3 12 21))))
      (cffi:with-foreign-object (pointer (if (eq dtype :f32) :float :double) 32)
        (let* ((storage (trivial-simd:make-vector-view pointer dtype 32))
               (other (trivial-simd:make-vector-view (cffi:inc-pointer pointer (* 4 (ct:dtype-bytes dtype))) dtype 24))
               (a (ct:make-tensor-view storage '(2 2 2)))
               (b (ct:from-data '((1 2) (3 4)) :dtype dtype))
               (out (ct:make-tensor-view other '(2 2 2))))
          (dotimes (i 32) (setf (ct:storage-ref storage i) (ct::coerce-value (mod i 7) dtype)))
          (check-matmul a b out)))
      (let ((a (ct:make-tensor-view (make-instance 'fusion-storage :data (ct:tensor-storage (ct:ones '(3 4) :dtype dtype)))
                                   '(3 4))))
        (check-matmul a (ct:ones '(4 2) :dtype dtype))
        (check-fusion-values (ct:sum a :axis -1) '(4 4 4))))
    (dolist (encoded '(:f16 :bf16))
      (let* ((a (ct:reshape (ct:arange 12) '(3 4)))
             (b (ct:astype (ct:reshape (ct:arange 20) '(4 5)) encoded)))
        (check-fusion-values (ct:matmul a b)
                             (tensor-values (let ((ct:*executor* nil)) (ct:matmul a b))))
        (check-fusion-values (ct:matmul (ct:transpose b) (ct:transpose a))
                             (tensor-values (let ((ct:*executor* nil))
                                              (ct:matmul (ct:transpose b) (ct:transpose a))))))
      (let* ((storage (ct:tensor-storage (ct:arange 24)))
             (a (ct:make-tensor-view storage '(3 4)))
             (b (ct:astype (ct:reshape (ct:arange 20) '(4 5)) encoded))
             (out (ct:make-tensor-view storage '(3 5)))
             (expected (let ((ct:*executor* nil)) (ct:matmul a b))))
        (ct:matmul! out a b)
        (check-fusion-values out (tensor-values expected))))))

(test operation-executor-layouts
  (check-executed-operations #'reversed-range-executor))

(test operation-executor-threaded
  (multiple-value-bind (executor close) (make-threaded-test-executor 3)
    (unwind-protect
         (progn
           (check-executed-operations executor)
           (eval '(ct:define-kernel cold-threaded-fusion (a) (/ a (ct:sum a))))
           (let ((ct:*executor* executor) (a (ct:ones '(9 4))))
             (check-fusion-values (funcall (symbol-function 'cold-threaded-fusion) a :axis -1)
                                  (make-list 36 :initial-element 0.25)))
           (let ((results (make-array 6)))
             (funcall executor 6
                      (lambda (start end)
                        (loop for index from start below end
                              do (let ((a (ct:full '(2 3) (1+ index))))
                                   (setf (aref results index) (fused-test-softmax a :axis -1))))))
             (loop for result across results do (check-fusion-values result (make-list 6 :initial-element (/ 1d0 3)))))
           (let ((ct:*executor* executor) (seen (make-array 7 :initial-element nil))
                 (trivial-simd::*backend* :lisp) (trivial-simd::*fma-mode* :fallback))
             (ct::call-with-operation-ranges
              7 (lambda (start end)
                  (loop for index from start below end
                        do (setf (aref seen index)
                                 (list trivial-simd::*backend* trivial-simd::*fma-mode* ct:*executor*)))))
             (is (every (lambda (value) (equal value '(:lisp :fallback nil))) seen)))
           (let ((ct:*executor* executor) (finished (make-array 7 :initial-element nil)))
             (signals error
               (ct::call-with-operation-ranges
                7 (lambda (start end)
                    (loop for index from start below end do (setf (aref finished index) t))
                    (when (zerop start) (error "Injected worker error")))))
             (is (every #'identity finished))
             (check-executed-operations executor)))
      (funcall close))))

(test operation-executor-validation-and-staging
  (let ((ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "Unexpected scheduling"))))
    (is (zerop (ct:tensor-size (ct:sum (ct:zeros '(0 4)) :axis -1))))
    (is (= 4 (ct:tref (ct:sum (ct:ones '(4))))))
    (is (= 4 (ct:tref (ct:matmul (ct:ones '(4)) (ct:ones '(4))))))
    (signals error (ct:matmul (ct:ones '(3 4)) (ct:ones '(5 2))))
    (signals error (ct:sum! (ct:zeros '(1)) (ct:ones '(3 4)) :axis -1)))
  (dolist (range '((-1 2) (0 9) (2 1) (0 1.5)))
    (let ((ct:*executor* (lambda (count callback) (declare (ignore count)) (apply callback range))))
      (signals error (ct:sum (ct:ones '(3 4)) :axis -1))))
  (let* ((a (ct:ones '(3 4))) (out (ct:full '(3) 19))
         (ct:*executor* (lambda (count callback)
                         (declare (ignore count)) (funcall callback 0 1) (error "Executor failed"))))
    (signals error (ct:sum! out a :axis -1))
    (is (equalp '(19 19 19) (tensor-values out))))
  (let* ((a (ct:ones '(3 4))) (out (ct:full '(3 4) 19))
         (ct:*executor* (lambda (count callback)
                         (declare (ignore count)) (funcall callback 0 1) (error "Executor failed"))))
    (signals error (fused-test-softmax! out a :axis -1))
    (is (every (lambda (value) (= value 19)) (tensor-values out)))))

(defclass private-executor-dtype (ct:dtype) ())
(ct:register-dtype
 (or (ignore-errors (ct:find-dtype :private-executor-test))
     (make-instance 'private-executor-dtype :name :private-executor-test
                    :element-type 'single-float :block-bytes 4 :zero 0f0)))
(defmethod ct:resolve-operation ((dtype private-executor-dtype) operation inputs options)
  (declare (ignore inputs options))
  (when (member operation '(:sum :matmul))
    (values :f32 (lambda (out inputs options)
                   (declare (ignore inputs options)) (fill (ct:tensor-storage out) 7f0)))))

(test custom-selectors-own-scheduling
  (let ((ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "Unexpected core scheduling")))
        (a (ct:zeros '(3 3) :dtype :private-executor-test)))
    (is (equalp '(7 7 7) (tensor-values (ct:sum a :axis -1))))
    (is (equalp '(7 7 7 7 7 7 7 7 7) (tensor-values (ct:matmul a a))))))
