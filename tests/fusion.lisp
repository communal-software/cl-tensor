(in-package #:cl-tensor/tests)
(in-suite :cl-tensor)

(ct:define-kernel fused-test-multiply-add (a b c) (+ (* a b) c))
(ct:define-kernel fused-test-dot (a b) (ct:sum (* a b)))
(ct:define-kernel fused-test-softmax (x)
  (/ (exp (- x (ct:maximum x)))
     (ct:sum (exp (- x (ct:maximum x))))))

(trivial-simd:define-kernel fusion-memory-probe (a b) (+ (* a b) 1))
(defvar *fusion-allocations* nil)
(defvar *record-fusion-allocations* nil)
(defmethod ct:allocate-storage :before ((dtype ct:dtype) shape)
  (when *record-fusion-allocations* (push (coerce shape 'list) *fusion-allocations*)))

(defun check-fusion-values (actual expected)
  (is (= (length expected) (ct:tensor-size actual)))
  (let ((tolerance (if (eq (ct:tensor-dtype actual) :f32) 1d-5 1d-12)))
    (loop for value in (tensor-values actual) for reference in expected
          do (is (<= (abs (- value reference)) (* tolerance (max 1d0 (abs reference))))))))

(defclass fusion-storage ()
  ((data :initarg :data :reader fusion-data) (fail-at :initarg :fail-at :initform nil)))
(defmethod ct:storage-length ((storage fusion-storage)) (length (fusion-data storage)))
(defmethod ct:storage-element-type ((storage fusion-storage)) (array-element-type (fusion-data storage)))
(defmethod ct:storage-readable-p ((storage fusion-storage)) t)
(defmethod ct:storage-writable-p ((storage fusion-storage)) t)
(defmethod ct:storage-ref ((storage fusion-storage) index)
  (when (eql index (slot-value storage 'fail-at)) (error "Injected fusion read failure"))
  (aref (fusion-data storage) index))
(defmethod (setf ct:storage-ref) (value (storage fusion-storage) index)
  (setf (aref (fusion-data storage) index) value))

(test fusion-arithmetic-and-layouts
  (dolist (dtype '(:f32 :f64))
    (dolist (size '(0 1 19 4096 4097 8193))
      (let* ((a (ct:arange size :dtype dtype)) (b 2) (c 3))
        (check-fusion-values (ct:fuse (+ (* a b) c))
                             (loop for i below size collect (+ (* i b) c)))
        (check-fusion-values (fused-test-multiply-add a b c)
                             (loop for i below size collect (+ (* i b) c)))))
    (let* ((a (ct:reshape (ct:arange 24 :dtype dtype) '(2 3 4)))
           (b (ct:from-data '((2) (3) (4)) :dtype dtype))
           (c -1))
      (dolist (input (list a (ct:transpose a) (ct:slice a :selectors '(:all :all (nil nil -1)))))
        (let* ((a input) (b (if (= (aref (ct:tensor-shape a) 1) 3) b 2))
               (reference (ct:add (ct:multiply a b) c))
               (out (ct:transpose (ct:zeros (reverse (coerce (ct:tensor-shape a) 'list)) :dtype dtype))))
          (check-fusion-values (ct:fuse (+ (* a b) c)) (tensor-values reference))
          (is (eq out (fused-test-multiply-add! out a b c)))
          (check-fusion-values out (tensor-values reference))))))
  (let* ((a (ct:arange 9000)) (b (ct:make-tensor-view (ct:tensor-storage a) '(9000) :strides '(-1) :offset 8999)))
    (check-fusion-values (ct:fuse (+ a b)) (make-list 9000 :initial-element 8999))))

(test fusion-reductions-and-nesting
  (dolist (dtype '(:f32 :f64))
    (let* ((base (ct:reshape (ct:arange 1 25 :dtype dtype) '(2 3 4))) (b 2))
      (dolist (a (list base (ct:transpose base) (ct:slice base :selectors '(:all :all (nil nil -1)))))
        (dolist (axis '(nil 0 -1 (0 2) #()))
          (let ((product (ct:multiply a b)))
            (dolist (keepdims '(nil t))
              (let ((actual (ct:fuse (ct:sum (* a b)) :axis axis :keepdims keepdims))
                    (reference (ct:sum product :axis axis :keepdims keepdims)))
                (is (equalp (ct:tensor-shape actual) (ct:tensor-shape reference)))
                (check-fusion-values actual (tensor-values reference))))
            (check-fusion-values (fused-test-dot a b :axis axis) (tensor-values (ct:sum product :axis axis)))
            (check-fusion-values (ct:fuse (ct:prod a) :axis axis) (tensor-values (ct:prod a :axis axis)))
            (check-fusion-values (ct:fuse (ct:minimum a) :axis axis) (tensor-values (ct:minimum a :axis axis)))
            (check-fusion-values (ct:fuse (ct:maximum a) :axis axis) (tensor-values (ct:maximum a :axis axis)))
            (let ((result (ct:fuse (ct:argmin a) :axis axis)))
              (is (eq :s64 (ct:tensor-dtype result)))
              (is (equalp (tensor-values result) (tensor-values (ct:argmin a :axis axis)))))
            (is (equalp (tensor-values (ct:fuse (ct:argmax a) :axis axis))
                        (tensor-values (ct:argmax a :axis axis)))))
          (let* ((axes (if (null axis) (loop for i below (ct:tensor-rank a) collect i)
                          (ct::normalize-axes axis (ct:tensor-rank a))))
                 (reference (normalization-reference :softmax a axes)))
            (check-fusion-values (fused-test-softmax a :axis axis) reference)
            (check-fusion-values (ct:fuse (/ (exp (- a (ct:maximum a)))
                                           (ct:sum (exp (- a (ct:maximum a))))) :axis axis)
                                 reference)))))
    (let ((a (ct:from-data '((4 1 1) (2 2 3)) :dtype dtype)))
      (is (equal '(1 0) (tensor-values (ct:fuse (ct:argmin a) :axis -1))))
      (check-fusion-values (ct:fuse (+ a (ct:argmin a)) :axis -1) '(5 2 2 2 2 3)))
    (let* ((a (ct:reshape (ct:arange 12 :dtype dtype) '(2 3 2)))
           (b (ct:from-data '(1 2) :dtype dtype)))
      (check-fusion-values (ct:fuse (ct:sum (* a b)) :axis '(0 2))
                           (tensor-values (ct:sum (ct:multiply a b) :axis '(0 2)))))))

(test fusion-math-and-selection
  (dolist (dtype '(:f32 :f64))
    (let* ((a (ct:from-data '(0.25 0.5 1 2) :dtype dtype))
           (b 2))
      (check-fusion-values (ct:fuse (+ (exp a) (sin a) (cos a) (log a) (tanh a) (ct:sigmoid a)))
                           (mapcar (lambda (x) (+ (exp x) (sin x) (cos x) (log x) (tanh x)
                                                  (/ 1 (+ 1 (exp (- x)))))) (tensor-values a)))
      (check-fusion-values (ct:fuse (ct:select (> a 1) (sqrt a) (- a))) '(-0.25 -0.5 -1 1.4142135623730951d0))
      (check-fusion-values (ct:fuse (ct:sum (ct:select (> a 1) a 0))) '(2))
      (check-fusion-values (ct:fuse (trivial-simd:fma a b 1)) '(1.5 2 3 5))
      (check-fusion-values (ct:fuse (min (max (abs (- a)) 0.5) 1)) '(0.5 0.5 1 1))))
  (let ((a (ct:from-data '(1 -1))))
    (check-fusion-values (ct:fuse (ct:select (> a 0) (sqrt a) 0)) '(1 0))))

(test fusion-empty-and-validation
  (let ((a (ct:zeros '(3 0))))
    (is (equalp '(0 0 0) (tensor-values (ct:fuse (ct:sum a) :axis -1))))
    (is (equalp '(1 1 1) (tensor-values (ct:fuse (ct:prod a) :axis -1))))
    (is (zerop (ct:tensor-size (ct:fuse (/ a (ct:minimum a)) :axis -1))))
    (signals error (ct:fuse (ct:maximum a) :axis -1)))
  (let ((a (ct:zeros '(0 3))))
    (is (zerop (ct:tensor-size (ct:fuse (ct:argmin a) :axis -1)))))
  (let ((a (ct:full nil 4))) (is (= 16 (ct:tref (ct:fuse (ct:sum (* a a)))))))
  (dolist (form '((ct:fuse (ct:mean a)) (ct:fuse (> a 0)) (ct:fuse (atan a))
                  (ct:fuse (ct:select a 1 0)) (ct:fuse (+))
                  (ct:define-kernel bad-kernel (a) (+ a b))))
    (signals error (macroexpand-1 form)))
  (let ((a (ct:ones '(2))) (b (ct:ones '(2) :dtype :f64)))
    (signals error (ct:fuse (+ a b)))
    (signals error (ct:fuse a :keepdims t))
    (signals error (ct:fuse (ct:sum a) :axis '(0 0)))
    (signals error (ct:fuse (ct:sum a) :axis 1))
    (signals error (ct:fuse! (ct:zeros '(1)) a))
    (signals type-error (ct:fuse! nil a))
    (signals type-error (fused-test-multiply-add! nil a 2 3))
    (signals error (ct:fuse! (ct:zeros '(2) :dtype :f64) a))
    (signals error (ct:fuse! (ct:make-tensor-view (ct:tensor-storage a) '(2) :strides '(0)) a)))
  (let ((a (ct:ones '(2) :dtype :s32))) (signals error (ct:fuse a)))
  (let ((a 2)) (signals error (ct:fuse (+ a 1)))))

(test fusion-aliases-and-failures
  (let ((a (ct:from-data '(1 4 -1))) (out (ct:full '(3) 17)))
    (signals error (ct:fuse! out (sqrt a)))
    (is (equalp '(17 17 17) (tensor-values out))))
  (let* ((storage (ct:tensor-storage (ct:arange 8)))
         (a (ct:make-tensor-view storage '(6)))
         (out (ct:make-tensor-view storage '(6) :offset 1)))
    (is (eq out (ct:fuse! out (+ a 2))))
    (is (equalp '(2 3 4 5 6 7) (tensor-values out))))
  (let* ((a (ct:reshape (ct:arange 1 13) '(3 4)))
         (expected (tensor-values (fused-test-softmax a :axis -1))))
    (is (eq a (fused-test-softmax! a a :axis -1)))
    (check-fusion-values a expected))
  (let* ((storage (make-instance 'fusion-storage :data (ct:tensor-storage (ct:arange 5000)) :fail-at 4999))
         (a (ct:make-tensor-view storage '(5000)))
         (out (ct:full '(5000) 17)))
    (signals error (ct:fuse! out (+ a 1)))
    (is (every (lambda (x) (= x 17)) (tensor-values out))))
  (let* ((data (ct:tensor-storage (ct:arange 6)))
         (a (ct:make-tensor-view (make-instance 'fusion-storage :data data) '(2 3)))
         (out (ct:make-tensor-view (make-instance 'fusion-storage :data data) '(2 3))))
    (ct:fuse! out (+ a 1))
    (is (equalp '(1 2 3 4 5 6) (tensor-values out)))))

(test fusion-foreign-views
  (cffi:with-foreign-object (pointer :float 16)
    (dotimes (i 16) (setf (cffi:mem-aref pointer :float i) (float i 1f0)))
    (let* ((storage (trivial-simd:make-vector-view pointer :f32 16))
           (a (ct:make-tensor-view storage '(3 4) :strides '(5 -1) :offset 3))
           (out (ct:make-tensor-view storage '(3 4) :strides '(5 1)))
           (expected (mapcar (lambda (x) (+ (* x x) 1)) (tensor-values a))))
      (ct:fuse! out (+ (* a a) 1))
      (check-fusion-values out expected)
      (check-fusion-values (ct:fuse (ct:sum a) :axis -1)
                           (tensor-values (ct:sum a :axis -1))))))

(test fusion-capture-and-redefinition
  (let ((reads 0) (input (ct:ones '(3))))
    (symbol-macrolet ((a (progn (incf reads) input)))
      (is (equalp '(3 3 3) (tensor-values (ct:fuse (+ a a a))))))
    (is (= 1 reads)))
  (eval '(ct:define-kernel redefined-fusion (a) (+ a 1)))
  (let ((old (symbol-function 'redefined-fusion)) (a (ct:ones '(2))))
    (eval '(ct:define-kernel redefined-fusion (a) (* a 3)))
    (is (equalp '(2 2) (tensor-values (funcall old a))))
    (is (equalp '(3 3) (tensor-values (funcall (symbol-function 'redefined-fusion) a))))))

(test fusion-workspace-and-kernel-reuse
  (let* ((a (ct:make-tensor-view (make-instance 'fusion-storage :data (ct:tensor-storage (ct:ones '(9000))))
                                 '(9000)))
         (*fusion-allocations* nil) (*record-fusion-allocations* t) (calls 0))
    (ct::run-fusion
     (lambda (out a b &rest options)
       (incf calls)
       (is (<= (length a) 4096))
       (is (<= (length b) 4096))
       (apply #'fusion-memory-probe out a b options))
     '((:a-start :a-row-stride) (:b-start :b-row-stride)) (list a 2f0) nil nil nil nil nil)
    (is (> calls 1))
    (is (equal '((9000)) *fusion-allocations*)))
  (let* ((a (ct:ones '(9000))) (*fusion-allocations* nil) (*record-fusion-allocations* t))
    (ct:fuse (+ (* a a) (sqrt a)))
    (is (equal '((9000)) *fusion-allocations*)))
  (let ((a (ct:ones '(5))) (b 2) (c 3))
    (flet ((operation () (ct:fuse (+ (* a b) c))))
      (dotimes (i 5) (is (equalp '(5 5 5 5 5) (tensor-values (operation))))))))

(test random-fusion-matches-coordinate-reference
  (let ((*state* #+sbcl (sb-ext:seed-random-state 1313) #-sbcl (make-random-state t)))
    (dotimes (trial 40)
      (let* ((shape (loop repeat (random-between 1 3) collect (random-between 1 3)))
             (a (random-data-view shape))
             (b (random-data-view (mapcar (lambda (dimension) (if (zerop (random-between 0 1)) 1 dimension))
                                         (nthcdr (random-between 0 (length shape)) shape))))
             (axes (loop for axis below (length shape) when (zerop (random-between 0 1)) collect axis))
             (kept (loop for axis below (length shape) unless (member axis axes) collect axis))
             (axis (coerce axes 'vector))
             (indices (all-indices shape)))
        (when (oddp trial)
          (flet ((double-view (input)
                   (ct:make-tensor-view
                    (map '(simple-array double-float (*)) (lambda (value) (float value 1d0)) (ct:tensor-storage input))
                    (ct:tensor-shape input) :strides (ct:tensor-strides input) :offset (ct:tensor-offset input))))
            (setf a (double-view a) b (double-view b))))
        (let* ((values (loop for index in indices collect
                            (+ (* (reference-broadcast-value a index) (reference-broadcast-value b index)) 1)))
               (group-indices (all-indices (mapcar (lambda (axis) (nth axis shape)) kept)))
               (reference (loop for group in group-indices collect
                                (loop for index in indices for value in values
                                      when (equal group (mapcar (lambda (axis) (nth axis index)) kept)) sum value))))
          (check-fusion-values (ct:fuse (+ (* a b) 1)) values)
          (check-fusion-values (ct:fuse (ct:sum (+ (* a b) 1)) :axis axis) reference))))))

(ct:define-kernel fused-test-lazy-root (a)
  (ct:select (> a 0) (sqrt a) 0))
(ct:define-kernel fused-test-lazy-normalize (a)
  (/ (ct:select (> a 0) (sqrt a) 0)
     (ct:sum (ct:select (> a 0) (sqrt a) 0))))

(test fusion-native-lazy-selection
  (when trivial-simd::*native-available-p*
    (let* ((entry-points '(trivial-simd::call-native-kernel
                           trivial-simd::call-declared-native
                           trivial-simd::call-native-kernel-reduction))
           (originals (mapcar #'symbol-function entry-points))
           (calls 0)
           (trivial-simd::*backend* :native))
      (unwind-protect
           (progn
             (loop for name in entry-points for original in originals
                   do (let ((function original))
                        (setf (symbol-function name)
                              (lambda (&rest arguments)
                                (incf calls)
                                (apply function arguments)))))
             (dolist (dtype '(:f32 :f64))
               (let ((base (ct:from-data '((1 -1 4) (-1 9 0)) :dtype dtype)))
                 (dolist (a (list base (ct:transpose base)
                                      (ct:slice base :selectors '(:all (nil nil -1)))))
                   (let ((expected (mapcar (lambda (x) (sqrt (max 0 x))) (tensor-values a)))
                         (out (ct:zeros (ct:tensor-shape a) :dtype dtype))
                         (before calls))
                     (check-fusion-values (ct:fuse (ct:select (> a 0) (sqrt a) 0)) expected)
                     (check-fusion-values (fused-test-lazy-root a) expected)
                     (check-fusion-values (fused-test-lazy-root! out a) expected)
                     (check-fusion-values (ct:fuse (ct:sum (ct:select (> a 0) (sqrt a) 0))) '(6))
                     (check-fusion-values (fused-test-lazy-normalize a)
                                          (mapcar (lambda (x) (/ x 6)) expected))
                     (let ((reference (let ((trivial-simd::*backend* :lisp))
                                        (ct:fuse (ct:sum (ct:select (> a 0) (sqrt a) 0)) :axis -1))))
                       (check-fusion-values
                        (ct:fuse (ct:sum (ct:select (> a 0) (sqrt a) 0)) :axis -1)
                        (tensor-values reference)))
                     (is (> calls before))))
                 (fused-test-lazy-root! base base)
                 (check-fusion-values base '(1 0 2 0 3 0)))
               (let ((a (ct:from-data '(-1 -4) :dtype dtype)))
                 (signals error (ct:fuse (ct:select (< a 0) (sqrt a) 0)))
                 (signals error (ct:fuse (ct:select (< a 0) (log a) 0)))))
             (is (plusp calls)))
        (loop for name in entry-points for original in originals
              do (setf (symbol-function name) original))))))
