(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu)

(defclass gather-mock-device (mock-device)
  ((loads :initform nil :accessor gather-loads)
   (launch-log :initform nil :accessor gather-launch-log)
   (failure :initform nil :accessor gather-failure)))

(defmethod gpu:device-allocate :before ((device gather-mock-device) bytes)
  (declare (ignore bytes))
  (when (eq (gather-failure device) :allocate) (error "Injected gather allocation failure")))

(defmethod gpu:device-prepare :before ((device gather-mock-device) source entry &key precise-math)
  (declare (ignore source entry precise-math))
  (when (eq (gather-failure device) :compile) (error "Injected gather compilation failure")))

(defmethod gpu:device-load :around ((device gather-mock-device) buffer sequence type offset)
  (push (list buffer (length sequence) (gpu:scalar-type-name type)) (gather-loads device))
  (when (eq (gather-failure device) :load) (error "Injected status completion failure"))
  (prog1 (call-next-method)
    (when (eq (gather-failure device) :bounds) (fill sequence 1))))

(defmethod gpu:device-launch :before ((device gather-mock-device) prepared arguments grid group)
  (declare (ignore grid group))
  (push (list prepared arguments) (gather-launch-log device))
  (when (eql (gather-failure device) (length (gather-launch-log device)))
    (error "Injected gather launch failure")))

(test gather-dispatch-types-and-transfer-contract
  (let ((device (make-instance 'gather-mock-device))
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (dolist (dtype *device-dtypes*)
      (tg:with-device-tensor (input (tg:make-device-tensor '(3 2) :dtype dtype :device device))
        (dolist (index-dtype '(:s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64))
          (tg:with-device-tensor (indices (tg:make-device-tensor '(2) :dtype index-dtype :device device))
            (setf (gather-loads device) nil (gather-launch-log device) nil)
            (tg:with-device-tensor (result (ct:take input indices))
              (is (eq dtype (ct:tensor-dtype result)))
              (is (eq device (gpu:gpu-array-device (ct:tensor-storage result))))
              (is (equalp #(2 2) (ct:tensor-shape result)))
              (is (ct:contiguous-p result))
              (is (not (eq (ct:tensor-storage result) (ct:tensor-storage input))))
              (is (= 3 (length (gather-launch-log device))))
              (is (= 1 (length (gather-loads device))))
              (is (equal '(1 gpu:u32) (cdr (first (gather-loads device)))))
              (is (not (member (caar (gather-loads device))
                               (list (gpu::array-buffer (ct:tensor-storage input))
                                     (gpu::array-buffer (ct:tensor-storage indices))
                                     (gpu::array-buffer (ct:tensor-storage result))))))
              (let ((before (waits device)))
                (setf (gather-loads device) nil (gather-launch-log device) nil)
                (is (eq result (ct:take! result input indices)))
                (is (< before (waits device)))
                (is (= 3 (length (gather-launch-log device))))
                (is (= 1 (length (gather-loads device))))))))))
    (is (= (allocations device) (frees device)))))

(test gather-validation-and-empty-indices
  (let ((device (make-instance 'gather-mock-device)) (other (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(3 0) :device device))
      (tg:with-device-tensor (indices (tg:make-device-tensor '(0) :dtype :s64 :device device))
        (tg:with-device-tensor (foreign (tg:make-device-tensor '(0) :dtype :s64 :device other))
          (tg:with-device-tensor (out (tg:make-device-tensor '(0 0) :device device))
            (let ((before (allocations device)))
              (dolist (thunk (list (lambda () (ct:take input indices :axis 2))
                                  (lambda () (ct:take input (ct:zeros '(0) :dtype :s64)))
                                  (lambda () (ct:take (ct:zeros '(3 0)) indices))
                                  (lambda () (ct:take input foreign))
                                  (lambda () (ct:take input out))
                                  (lambda () (ct:take! input input indices))
                                  (lambda () (ct:take! (ct:zeros '(0 0)) input indices))))
                (signals error (funcall thunk)))
              (is (= before (allocations device))))
            (is (eq out (ct:take! out input indices)))
            (tg:with-device-tensor (result (ct:take input indices))
              (is (equalp #(0 0) (ct:tensor-shape result))))))
        (is (null (gather-loads device)))
        (is (zerop (launches device)))))
    (is (= (allocations device) (frees device)))
    (is (= (allocations other) (frees other)))))

(defun host-values-for-gather (tensor)
  (cl-tensor/tests::tensor-values (tg:from-device tensor)))

(test gather-failures-release-scratch
  (let ((device (make-instance 'gather-mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(3) :device device))
      (tg:with-device-tensor (indices (tg:make-device-tensor '(2) :dtype :s64 :device device))
        (tg:with-device-tensor (out (tg:to-device (ct:full '(2) 77) :device device))
          (dolist (failure '(:compile :allocate 1 2 :load :bounds 3 :wait))
            (dolist (destination '(nil t))
              (setf (gather-failure device) failure (gather-launch-log device) nil
                    (fail-wait device) (eq failure :wait))
              (signals error (if destination (ct:take! out input indices) (ct:take input indices)))
              (is (= 3 (- (allocations device) (frees device))))
              (when (member failure '(1 2 :load :bounds))
                (is (<= (length (gather-launch-log device)) 2)))
              (setf (gather-failure device) nil (fail-wait device) nil)
              (is (equal '(77f0 77f0) (host-values-for-gather out))))))))
    (is (= (allocations device) (frees device)))))

(test gather-destination-validation-precedes-device-work
  (let ((device (make-instance 'gather-mock-device)) (other (make-instance 'mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(3 2) :device device))
      (tg:with-device-tensor (indices (tg:make-device-tensor '(2) :dtype :s64 :device device))
        (tg:with-device-tensor (backing (tg:make-device-tensor '(8) :device device))
          (tg:with-device-tensor (wrong-dtype (tg:make-device-tensor '(2 2) :dtype :s32 :device device))
            (tg:with-device-tensor (foreign (tg:make-device-tensor '(2 2) :device other))
              (let ((before (allocations device)))
                (dolist (out (list backing wrong-dtype foreign
                                   (ct:make-tensor-view (ct:tensor-storage backing) '(2 2) :strides '(0 1))))
                  (signals error (ct:take! out input indices)))
                (is (= before (allocations device))))))))
      (is (zerop (launches device)))
      (is (null (gather-loads device))))
    (is (= (allocations device) (frees device)))
    (is (= (allocations other) (frees other)))))
