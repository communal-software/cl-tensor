      (signals error (ct:matmul! (ct:zeros '(2 2) :dtype encoding) a b))
      (signals error (ct:matmul! (ct:make-tensor-view (ct:tensor-storage a) '(2 2) :strides '(0 1)) a b)))))

(test encoded-matmul-direct-foreign-weights
  (dolist (encoding '(:f16 :bf16))
    (let* ((values (ct:astype (ct:from-data '((1 2 3 4 5 6 7) (2 3 4 5 6 7 8) (3 4 5 6 7 8 9))) encoding))
           (x (ct:ones '(5 7))) (out (ct:zeros '(5 3)))
           (copies 0) (original (symbol-function 'cl-tensor::matmul-copy-matrix))
           (original-copy (symbol-function 'ct:copy-tensor)))
      (cffi:with-foreign-object (raw :uint16 21)
        (dotimes (i 21) (setf (cffi:mem-aref raw :uint16 i) (aref (ct:tensor-storage values) i)))
        (let* ((weights (ct:make-tensor-view (trivial-simd:make-vector-view raw :u16 21)
                                            '(3 7) :dtype encoding))
               (b (ct:transpose weights)))
          (unwind-protect
               (progn
                 (setf (symbol-function 'cl-tensor::matmul-copy-matrix)
                       (lambda (&rest args) (incf copies) (apply original args))
                       (symbol-function 'ct:copy-tensor)
                       (lambda (&rest args) (incf copies) (apply original-copy args)))
                 (ct:matmul! out x b)
                 (is (zerop copies))
                 (is (equalp '(28f0 35f0 42f0) (subseq (tensor-values out) 0 3))))
            (setf (symbol-function 'cl-tensor::matmul-copy-matrix) original
                  (symbol-function 'ct:copy-tensor) original-copy)))))))
