(in-package #:cl-tensor/gpu)

(defmacro define-copy-kernel (name element)
  `(gpu:define-kernel ,name
       ((input (gpu:ptr ,element :global)) (output (gpu:ptr ,element :global))
        (metadata (gpu:ptr gpu:i64 :global)) (rank gpu:u32) (n gpu:i64)
        (input-base gpu:i64) (output-base gpu:i64) (start gpu:i64))
     (let ((position (+ start (gpu:convert gpu:i64 (gpu:global-id 0)))))
       (when (< position n)
         (let ((q position) (source input-base) (target output-base))
           (declare (type gpu:i64 q source target))
           (gpu:for (axis 0 (< axis rank) (incf axis))
             (let* ((at (* (gpu:convert gpu:i64 axis) 3))
                    (dimension (aref metadata at))
                    (coordinate (rem q dimension)))
               (incf source (* coordinate (aref metadata (+ at 1))))
               (incf target (* coordinate (aref metadata (+ at 2))))
               (setf q (/ q dimension))))
           (setf (aref output target) (aref input source)))))))

(define-copy-kernel copy-f32 gpu:f32)
(define-copy-kernel copy-s64 gpu:i64)
