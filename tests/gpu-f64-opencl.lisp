(in-package #:cl-tensor/gpu/tests)
(export 'run-opencl-tests)
(def-suite :cl-tensor/gpu/opencl)
(in-suite :cl-tensor/gpu/opencl)

(defun run-opencl-tests ()
  (let ((gpu:*device* (or gpu:*device* (cl-gpu/opencl:default-device))))
    (unless (gpu:device-native-type-p gpu:*device* 'gpu:f64)
      (error "OpenCL tensor conformance requires a native-f64 device"))
    (run! :cl-tensor/gpu/opencl)))

(defvar *f64-forbid-download* nil)
(defvar *f64-allow-status* nil)
(defmethod gpu:device-load :before ((device cl-gpu/opencl:opencl-device) buffer sequence type offset)
  (declare (ignore buffer offset))
  (when (and *f64-forbid-download*
             (not (and *f64-allow-status* (= 1 (length sequence))
                       (eq type (gpu:parse-type 'gpu:u32)))))
    (error "Unexpected operand/result download during f64 computation")))

(defun f64-values (tensor) (cl-tensor/tests::tensor-values tensor))

(defun f64-result-matches (expected actual)
  (and (equalp (ct:tensor-shape expected) (ct:tensor-shape actual))
       (eq (ct:tensor-dtype expected) (ct:tensor-dtype actual))
       (if (member (ct:tensor-dtype expected) '(:f32 :f64))
           (every (lambda (x y) (<= (abs (- x y)) (* 2d-13 (max 1d0 (abs x)))))
                  (f64-values expected) (f64-values actual))
           (equal (f64-values expected) (f64-values actual)))))

(defmacro check-f64 (expected form)
  `(let ((reference ,expected))
     (tg:with-device-tensor (result (let ((*f64-forbid-download* t)) ,form))
       (is (f64-result-matches reference (tg:from-device result))))))

(test opencl-f64-elementwise-and-scalars
  (let ((cpu (ct:from-data '(0.25d0 0.75d0 1.0000000000000002d0 2d0) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (dolist (spec '((ct:add +) (ct:subtract -) (ct:multiply *) (ct:divide /) (ct:min min) (ct:max max)))
        (destructuring-bind (operation reference) spec
          (check-f64 (ct:from-data (mapcar (lambda (x) (funcall reference x 1.0000000000000002d0))
                                         (f64-values cpu)) :dtype :f64)
                     (funcall operation input 1.0000000000000002d0))))
      (dolist (spec '((ct:negate -) (ct:abs abs) (ct:sqrt sqrt) (ct:reciprocal /)
                      (ct:exp exp) (ct:log log) (ct:sin sin) (ct:cos cos) (ct:tanh tanh)))
        (destructuring-bind (operation reference) spec
          (check-f64 (ct:from-data (mapcar reference (f64-values cpu)) :dtype :f64)
                     (funcall operation input))))
      (dolist (operation '(ct:sigmoid ct:silu ct:gelu))
        (check-f64 (funcall operation cpu) (funcall operation input)))
      (check-f64 (ct:clamp cpu 0.5d0 1.0000000000000002d0)
                 (ct:clamp input 0.5d0 1.0000000000000002d0))
      (dolist (operator '(:eq :ne :lt :le :gt :ge))
        (check-f64 (ct:compare operator cpu 1d0) (ct:compare operator input 1d0)))
      (tg:with-device-tensor (mask (ct:compare :gt input 1d0))
        (check-f64 (ct:select (ct:compare :gt cpu 1d0) cpu 1.0000000000000002d0)
                   (ct:select mask input 1.0000000000000002d0))
        (check-f64 (ct:select (ct:compare :gt cpu 1d0) 1.0000000000000002d0 0d0 :dtype :f64)
                   (ct:select mask 1.0000000000000002d0 0d0 :dtype :f64)))))
  (tg:with-device-tensor (out (tg:make-device-tensor nil :dtype :f64))
    (let ((*f64-forbid-download* t)) (ct:add! out 1d0 (expt 2d0 -52)))
    (is (= 1.0000000000000002d0 (ct:tref (tg:from-device out)))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(16777217d0 1d-200 1d200) :dtype :f64)))
    (tg:with-device-tensor (out (let ((*f64-forbid-download* t)) (ct:add input 0d0)))
      (is (equal '(16777217d0 1d-200 1d200) (f64-values (tg:from-device out)))))))

(test opencl-f64-layouts-reductions-and-normalization
  (let ((base (ct:from-data (loop for i below 60 collect (+ 0.8d0 (* 0.02d0 (mod i 13)) (expt 2d0 -40)))
                             :dtype :f64)))
    (tg:with-device-tensor (device-base (tg:to-device base))
      (gpu:with-gpu-array (window (gpu:make-gpu-array-view (ct:tensor-storage device-base) 48 :offset 3))
        (dolist (layout '(((2 3 4) (12 4 1) 0) ((4 2 3) (1 12 4) 0)
                          ((2 3 4) (12 -4 1) 8) ((2 3 4) (24 8 2) 0)
                          ((2 3 4) (0 4 1) 0)))
          (destructuring-bind (shape strides offset) layout
            (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) shape :strides strides :offset (+ 3 offset)))
                   (input (ct:make-tensor-view window shape :strides strides :offset offset)))
              (check-f64 (ct:add cpu 1.0000000000000002d0) (ct:add input 1.0000000000000002d0))
              (check-f64 (ct:copy-tensor cpu) (ct:copy-tensor input))
              (check-f64 (ct:reshape cpu '(24)) (ct:reshape input '(24)))
              (dolist (axis '(nil -1 (2 0) #()))
                (dolist (operation '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax))
                  (dolist (keepdims '(nil t))
                    (check-f64 (funcall operation cpu :axis axis :keepdims keepdims)
                               (funcall operation input :axis axis :keepdims keepdims))))
                (dolist (operation '(ct:softmax ct:rmsnorm))
                  (check-f64 (funcall operation cpu :axis axis)
                             (funcall operation input :axis axis))))))))))
  (let ((cpu (ct:from-data '((16777217d0 1d0) (2d0 3d0)) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (dolist (operation '(ct:sum ct:mean ct:softmax ct:rmsnorm))
        (check-f64 (funcall operation cpu :axis -1 :accumulate :f64)
                   (funcall operation input :axis -1 :accumulate :f64)))
      (tg:with-device-tensor (sum (ct:sum input :axis -1))
        (is (equal '(16777218d0 5d0) (f64-values (tg:from-device sum)))))
      (check-f64 (ct:rmsnorm cpu :weights 1.0000000000000002d0 :epsilon 1.0000000000000002d0)
                 (ct:rmsnorm input :weights 1.0000000000000002d0 :epsilon 1.0000000000000002d0))
      (let ((weights (ct:from-data '(0.7d0 1.0000000000000002d0) :dtype :f64)))
        (tg:with-device-tensor (device-weights (tg:to-device weights))
          (check-f64 (ct:rmsnorm cpu :weights weights :epsilon 1d-20)
                     (ct:rmsnorm input :weights device-weights :epsilon 1d-20)))))))

(test opencl-f64-conversion-rounding-and-integer-boundaries
  (let ((cpu (ct:from-data '(-2.5d0 -0.5d0 0.5d0 1.5d0 2.5d0 300d0) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (let ((*f64-allow-status* t))
        (dolist (dtype '(:s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64 :f16 :bf16))
          (dolist (rounding '(:nearest-even :truncate :floor :ceiling))
            (check-f64 (ct:astype cpu dtype :rounding rounding)
                       (ct:astype input dtype :rounding rounding)))))))
  (dolist (dtype '(:s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64 :f32 :f16 :bf16))
    (let ((cpu (ct:astype (ct:from-data '(0 1 2 17) :dtype :f64) dtype)))
      (tg:with-device-tensor (input (tg:to-device cpu))
        (check-f64 (ct:astype cpu :f64) (ct:astype input :f64)))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(16777217d0 -16777217d0) :dtype :f64)))
    (dolist (spec '((:nearest-even 16777216f0 -16777216f0) (:truncate 16777216f0 -16777216f0)
                    (:floor 16777216f0 -16777218f0) (:ceiling 16777218f0 -16777216f0)))
      (tg:with-device-tensor (result (let ((*f64-forbid-download* t)) (ct:astype input :f32 :rounding (first spec))))
        (is (equal (rest spec) (f64-values (tg:from-device result)))))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(18446744073709551615 9223372036854775807)
                                                          :dtype :u64)))
    (tg:with-device-tensor (result (let ((*f64-forbid-download* t)) (ct:astype input :f64)))
      (is (equal '(18446744073709551616d0 9223372036854775808d0) (f64-values (tg:from-device result))))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(-1d200 1d200) :dtype :f64)))
    (let ((*f64-allow-status* t))
      (check-f64 (ct:from-data '(-9223372036854775808 9223372036854775807) :dtype :s64)
                 (ct:astype input :s64))
      (check-f64 (ct:from-data '(0 18446744073709551615) :dtype :u64) (ct:astype input :u64)))))

(test opencl-f64-raw-copies-and-aliases
  (let* ((bits '(#x8000000000000000 #x0000000000000001 #x7ff8000000001234 #x3ff0000000000001))
         (cpu (ct:from-data (mapcar #'float-features:bits-double-float bits) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (dolist (operation (list #'ct:copy-tensor (lambda (x) (ct:astype x :f64))))
        (tg:with-device-tensor (result (let ((*f64-forbid-download* t)) (funcall operation input)))
          (is (equal bits (mapcar #'float-features:double-float-bits (f64-values (tg:from-device result)))))))
      (let ((reverse (ct:make-tensor-view (ct:tensor-storage input) '(4) :strides '(-1) :offset 3)))
        (is (equal (reverse bits) (mapcar #'float-features:double-float-bits (f64-values (tg:from-device reverse))))))))
  (let ((cpu (ct:from-data '(1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0) :dtype :f64)))
    (tg:with-device-tensor (backing (tg:to-device cpu))
      (let ((input (ct:make-tensor-view (ct:tensor-storage backing) '(4)))
            (out (ct:make-tensor-view (ct:tensor-storage backing) '(4) :offset 1)))
        (let ((*f64-forbid-download* t)) (ct:add! out input 1d0))
        (is (equal '(1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0) (f64-values (tg:from-device backing)))))
      (let ((out (ct:make-tensor-view (ct:tensor-storage backing) '(2 2) :strides '(4 -2) :offset 2))
            (input (ct:make-tensor-view (ct:tensor-storage backing) '(2 2))))
        (let ((*f64-forbid-download* t)) (ct:multiply! out input 2d0))
        (is (equal '(4d0 2d0 2d0 4d0 8d0 6d0 6d0 8d0) (f64-values (tg:from-device backing))))))))

(test opencl-f64-empty-validation-and-failure-preservation
  (tg:with-device-tensor (input (tg:make-device-tensor '(0 3) :dtype :f64))
    (dolist (operation '(ct:add ct:subtract ct:multiply ct:divide))
      (check-f64 (ct:zeros '(0 3) :dtype :f64) (funcall operation input 1d0)))
    (dolist (operation '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax ct:softmax ct:rmsnorm))
      (tg:with-device-tensor (result (let ((*f64-forbid-download* t)) (funcall operation input :axis -1)))
        (is (zerop (ct:tensor-size result)))))
    (signals error (ct:sum input :axis 3))
    (signals error (ct:sum input :accumulate :f32))
    (signals ct:unsupported-operation (ct:matmul input (ct:transpose input)))
    (signals ct:unsupported-operation (ct:fuse (+ input 1d0))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(1d0 2d0 3d0) :dtype :f64)))
    (tg:with-device-tensor (lower (tg:to-device (ct:from-data '(0d0 5d0 0d0) :dtype :f64)))
      (tg:with-device-tensor (out (tg:to-device (ct:from-data '(9d0 8d0 7d0) :dtype :f64)))
        (let ((*f64-forbid-download* t) (*f64-allow-status* t))
          (signals gpu:gpu-error (ct:clamp! out input lower 4d0)))
        (is (equal '(9d0 8d0 7d0) (f64-values (tg:from-device out))))))))

(test opencl-f64-direct-half-rounding
  (dolist (spec '((:f16 11 #x3c01) (:bf16 8 #x3f81)))
    (destructuring-bind (dtype midpoint-bit expected-bits) spec
      (let ((cpu (ct:from-data (list (+ 1d0 (expt 2d0 (- midpoint-bit)) (expt 2d0 -40))) :dtype :f64)))
        (tg:with-device-tensor (input (tg:to-device cpu))
          (tg:with-device-tensor (encoded (let ((*f64-forbid-download* t)) (ct:astype input dtype)))
            (is (= expected-bits (ct:tref (tg:from-device encoded) 0)))))))))

(test opencl-f64-reduction-destinations-and-weight-aliases
  (let ((cpu (ct:from-data '((1d0 2d0 3d0) (4d0 5d0 6d0)) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (tg:with-device-tensor (backing (tg:to-device (ct:full '(5) 99d0 :dtype :f64)))
        (let ((out (ct:make-tensor-view (ct:tensor-storage backing) '(2) :strides '(-2) :offset 3)))
          (let ((*f64-forbid-download* t)) (ct:sum! out input :axis -1 :accumulate :f64))
          (is (equal '(99d0 15d0 99d0 6d0 99d0) (f64-values (tg:from-device backing))))))
      (let ((expected (ct:rmsnorm cpu :weights cpu :epsilon 1d-20)))
        (let ((*f64-forbid-download* t)) (ct:rmsnorm! input input :weights input :epsilon 1d-20))
        (is (f64-result-matches expected (tg:from-device input)))))))

(test opencl-f64-empty-group-identities-and-errors
  (tg:with-device-tensor (input (tg:make-device-tensor '(2 0) :dtype :f64))
    (check-f64 (ct:zeros '(2) :dtype :f64) (ct:sum input :axis -1))
    (check-f64 (ct:ones '(2) :dtype :f64) (ct:prod input :axis -1))
    (tg:with-device-tensor (out (tg:to-device (ct:from-data '(9d0 8d0) :dtype :f64)))
      (dolist (operation '(ct:mean! ct:minimum! ct:maximum!))
        (let ((*f64-forbid-download* t))
          (signals error (funcall operation out input :axis -1)))
        (is (equal '(9d0 8d0) (f64-values (tg:from-device out))))))))
