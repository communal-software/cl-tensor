(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu/metal)

(defun check-fusion-values (expected result &optional (shape (ct:tensor-shape result)) (dtype :f32))
  (is (equalp (coerce shape 'vector) (ct:tensor-shape result)))
  (is (eq dtype (ct:tensor-dtype result)))
  (let ((actual (host-values (tg:from-device result))))
    (is (= (length expected) (length actual)))
    (is (every (lambda (x y) (<= (abs (- x y)) (* 1d-4 (max 1d0 (abs x) (abs y)))))
               expected actual))))

(defparameter *fusion-scalar-cases*
  '(((+ (* a b) 1) (lambda (x y) (+ (* x y) 1)))
    ((- a) (lambda (x y) (declare (ignore y)) (- x)))
    ((/ a) (lambda (x y) (declare (ignore y)) (/ x)))
    ((- a b 1) (lambda (x y) (- x y 1)))
    ((/ a b 2) (lambda (x y) (/ x y 2)))
    ((min a b 2) (lambda (x y) (min x y 2)))
    ((max a b 2) (lambda (x y) (max x y 2)))
    ((abs (- a b)) (lambda (x y) (abs (- x y))))
    ((sqrt a) (lambda (x y) (declare (ignore y)) (sqrt x)))
    ((exp a) (lambda (x y) (declare (ignore y)) (exp x)))
    ((sin a) (lambda (x y) (declare (ignore y)) (sin x)))
    ((cos a) (lambda (x y) (declare (ignore y)) (cos x)))
    ((log a) (lambda (x y) (declare (ignore y)) (log x)))
    ((tanh a) (lambda (x y) (declare (ignore y)) (tanh x)))
    ((ct:sigmoid a) (lambda (x y) (declare (ignore y)) (/ 1 (+ 1 (exp (- x))))))
    ((trivial-simd:fma a b 1) (lambda (x y) (+ (* x y) 1)))
    ((ct:select (= a b) a b) (lambda (x y) (if (= x y) x y)))
    ((ct:select (/= a b) a b) (lambda (x y) (if (/= x y) x y)))
    ((ct:select (< a b) a b) (lambda (x y) (if (< x y) x y)))
    ((ct:select (<= a b) a b) (lambda (x y) (if (<= x y) x y)))
    ((ct:select (> a b) a b) (lambda (x y) (if (> x y) x y)))
    ((ct:select (>= a b) a b) (lambda (x y) (if (>= x y) x y)))
    ((ct:select (> a 0) (sqrt a) (sqrt (- a)))
     (lambda (x y) (declare (ignore y)) (sqrt (abs x))))))

(test metal-fusion-elementwise-independent-references
  (let ((base (ct:from-data (loop for i below 50 collect (+ 0.2f0 (* 0.1f0 (mod i 13))))))
        (cases (loop for (expression scalar) in *fusion-scalar-cases* collect
                 (list (compile nil `(lambda (a b) (declare (ignorable a b)) (ct:fuse ,expression)))
                       (coerce scalar 'function)))))
    (tg:with-device-tensor (device-base (tg:to-device base))
      (dolist (layout '(((2 3) (3 1) 0) ((3 2) (1 3) 0) ((2 3) (3 -1) 2)
                        ((2 3) (12 2) 1) ((2 3) (0 1) 0)))
        (destructuring-bind (shape strides offset) layout
          (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) shape :strides strides :offset offset))
                 (input (mirror-view cpu (ct:tensor-storage device-base))))
            (dolist (case cases)
              (destructuring-bind (operation reference) case
                (let ((expected (mapcar (lambda (x) (funcall reference (float x 1d0) 1.3d0)) (host-values cpu))))
                  (tg:with-device-tensor (result (let ((*forbid-download* t)) (funcall operation input 1.3f0)))
                    (check-fusion-values expected result shape))))))))
      (let* ((a (ct:make-tensor-view (ct:tensor-storage device-base) '(2 3)))
             (b (ct:make-tensor-view (ct:tensor-storage device-base) '(3) :offset 9))
             (expected (loop for i below 2 append
                         (loop for j below 3 collect (+ (* (ct:tref base (+ (* i 3) j))
                                                          (ct:tref base (+ 9 j))) 1)))))
        (tg:with-device-tensor (result (let ((*forbid-download* t)) (ct:fuse (+ (* a b) 1))))
          (check-fusion-values expected result #(2 3)))))))

(defun fusion-reference-reduce (operation values)
  (ecase operation
    (ct:sum (reduce #'+ values :initial-value 0d0))
    (ct:prod (reduce #'* values :initial-value 1d0))
    (ct:minimum (reduce #'min values)) (ct:maximum (reduce #'max values))
    (ct:argmin (position (reduce #'min values) values))
    (ct:argmax (position (reduce #'max values) values))))

(test metal-fusion-reduction-groups-and-indices
  (let ((base (ct:from-data '(3 1 1 4 2 2 5 0 0 6 6 1)))
        (operations (loop for reducer in '(ct:sum ct:prod ct:minimum ct:maximum ct:argmin ct:argmax)
                          collect (cons reducer (compile nil `(lambda (a axis keepdims)
                                                                (ct:fuse (,reducer a) :axis axis :keepdims keepdims)))))))
    (tg:with-device-tensor (device-base (tg:to-device base))
      (dolist (layout '(((3 4) (4 1) 0) ((3 4) (4 -1) 3)
                        ((3 4) (0 1) 0) ((3 4) (1 3) 0)))
        (destructuring-bind (shape strides offset) layout
          (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) shape :strides strides :offset offset))
                 (input (mirror-view cpu (ct:tensor-storage device-base))))
            (dolist (axis '(nil 0 -1 (1 0) #()))
              (let* ((axes (cond ((null axis) '(0 1)) ((equalp axis #()) nil)
                                 ((listp axis) '(0 1)) ((= axis 0) '(0)) (t '(1))))
                     (kept (loop for a below 2 unless (member a axes) collect a))
                     (result-shape (mapcar (lambda (a) (nth a shape)) kept))
                     (groups
                       (loop for output in (cl-tensor/tests::all-indices result-shape) collect
                         (loop for index in (cl-tensor/tests::all-indices shape)
                               when (equal output (mapcar (lambda (a) (nth a index)) kept))
                                 collect (float (apply #'ct:tref cpu index) 1d0)))))
                (dolist (reducer '(ct:sum ct:prod ct:minimum ct:maximum ct:argmin ct:argmax))
                  (let ((operation (cdr (assoc reducer operations)))
                        (expected (mapcar (lambda (values) (fusion-reference-reduce reducer values)) groups)))
                    (dolist (keepdims '(nil t))
                      (tg:with-device-tensor (result (let ((*forbid-download* t))
                                                      (funcall operation input axis keepdims)))
                        (check-fusion-values expected result
                                             (if keepdims (mapcar (lambda (a) (if (member a axes) 1 (nth a shape))) '(0 1))
                                                 result-shape)
                                             (if (member reducer '(ct:argmin ct:argmax)) :s64 :f32))))))))))))))

(test metal-fusion-nested-and-lazy-reductions
  (let ((cpu (ct:from-data '((-4 -1 -1) (1 2 2)))))
    (tg:with-device-tensor (a (tg:to-device cpu))
      (let* ((rows '((-4d0 -1d0 -1d0) (1d0 2d0 2d0)))
             (softmax (loop for row in rows append
                        (let* ((maximum (reduce #'max row))
                               (values (mapcar (lambda (x) (exp (- x maximum))) row))
                               (sum (reduce #'+ values)))
                          (mapcar (lambda (x) (/ x sum)) values)))))
        (tg:with-device-tensor (result (let ((*forbid-download* t))
                                        (ct:fuse (/ (exp (- a (ct:maximum a)))
                                                    (ct:sum (exp (- a (ct:maximum a))))) :axis -1)))
          (check-fusion-values softmax result #(2 3))))
      (tg:with-device-tensor (result (let ((*forbid-download* t))
                                      (ct:fuse (+ a (ct:argmax a)) :axis -1)))
        (check-fusion-values '(-3 0 0 2 3 3) result))
      (tg:with-device-tensor (result (let ((*forbid-download* t))
                                      (ct:fuse (ct:select (> a 0) (ct:sum (sqrt a)) 7) :axis -1)))
        (check-fusion-values (append '(7 7 7) (make-list 3 :initial-element (+ 1 (* 2 (sqrt 2d0))))) result))
      (tg:with-device-tensor (result (let ((*forbid-download* t))
                                      (ct:fuse (ct:sum (ct:select (> a 0) (sqrt a) (sqrt (- a)))) :axis -1)))
        (check-fusion-values (list 4 (+ 1 (* 2 (sqrt 2d0)))) result #(2))))))

(test metal-fusion-destinations-windows-and-snapshots
  (let ((cpu (ct:from-data (loop for i below 30 collect (1+ i)))))
    (tg:with-device-tensor (base (tg:to-device cpu))
      (let* ((window (gpu:make-gpu-array-view (ct:tensor-storage base) 24 :offset 2))
             (a (ct:make-tensor-view window '(2 3) :strides '(3 -1) :offset 2))
             (expected '(11 9 7 17 15 13)))
        (tg:with-device-tensor (result (let ((*forbid-download* t)) (ct:fuse (+ (* a 2) 1))))
          (check-fusion-values expected result))
        (let ((out (ct:make-tensor-view window '(2 3) :strides '(3 1) :offset 1)))
          (is (eq out (let ((*forbid-download* t)) (ct:fuse! out (+ (* a 2) 1)))))
          (check-fusion-values expected out))))
    (tg:with-device-tensor (base (tg:to-device cpu))
      (let ((a (ct:make-tensor-view (ct:tensor-storage base) '(2 3))))
        (is (eq a (let ((*forbid-download* t)) (gpu-fusion-affine! a a 2 1 nil))))
        (check-fusion-values '(3 5 7 9 11 13) a)))
    (tg:with-device-tensor (a (tg:to-device (ct:from-data '((1 2 3) (4 5 6)))))
      (tg:with-device-tensor (base (tg:to-device (ct:full '(20) 77)))
        (let ((out (ct:make-tensor-view (ct:tensor-storage base) '(2 3) :strides '(-8 2) :offset 10)))
          (ct:fuse! out (+ a 1))
          (check-fusion-values '(2 3 4 5 6 7) out)
          (loop for value in (host-values (tg:from-device base)) for i from 0
                unless (member i '(10 12 14 2 4 6)) do (is (= 77 value))))))))

(test metal-fusion-empty-and-rank-zero
  (tg:with-device-tensor (a (tg:to-device (ct:from-data 3)))
    (tg:with-device-tensor (result (ct:fuse (+ a 1)))
      (check-fusion-values '(4) result #()))
    (tg:with-device-tensor (result (ct:fuse (ct:argmin a)))
      (check-fusion-values '(0) result #() :s64)))
  (tg:with-device-tensor (a (tg:make-device-tensor '(2 0)))
    (tg:with-device-tensor (result (ct:fuse (+ a 1)))
      (check-fusion-values nil result #(2 0)))
    (tg:with-device-tensor (result (ct:fuse (ct:sum (log a)) :axis 1))
      (check-fusion-values '(0 0) result #(2)))
    (tg:with-device-tensor (result (ct:fuse (ct:prod (log a)) :axis 1))
      (check-fusion-values '(1 1) result #(2)))
    (signals error (ct:fuse (ct:maximum a) :axis 1))))

(defvar *fusion-metal-failure* nil)

(defun inject-fusion-metal-failure (step)
  (when (eq step *fusion-metal-failure*)
    (setf *fusion-metal-failure* nil)
    (error "Injected fusion ~A failure" step)))

(defmethod gpu:device-prepare :before ((device cl-gpu/metal::metal-device) source entry &key precise-math)
  (declare (ignore device source entry precise-math))
  (inject-fusion-metal-failure :compile))
(defmethod gpu:device-launch :before ((device cl-gpu/metal::metal-device) prepared arguments grid group)
  (declare (ignore device prepared arguments grid group))
  (inject-fusion-metal-failure :launch))
(defmethod gpu:device-synchronize :before ((device cl-gpu/metal::metal-device))
  (declare (ignore device))
  (inject-fusion-metal-failure :completion))

(test metal-fusion-failure-destinations-and-retry
  (tg:with-device-tensor (a (tg:to-device (ct:from-data '(1 2 3))))
    (tg:with-device-tensor (out (tg:to-device (ct:full '(3) 77)))
      (dolist (step '(:compile :launch :completion))
        (let ((operation (compile nil '(lambda (out a) (ct:fuse! out (+ a 1))))))
          (tg:with-device-tensor (initial (tg:to-device (ct:full '(3) 77)))
            (ct:copy-storage! (ct:find-dtype :f32) out initial))
          (let ((*fusion-metal-failure* step) (*forbid-download* t))
            (signals error (funcall operation out a))
            (is (null *fusion-metal-failure*)))
          (check-fusion-values '(77 77 77) out)
          (is (eq out (funcall operation out a)))
          (check-fusion-values '(2 3 4) out))))))

(test metal-fusion-retained-definitions-and-concurrent-calls
  (tg:with-device-tensor (a (tg:to-device (ct:from-data '(1 2 3))))
    (eval '(ct:define-kernel metal-redefined (a) (+ a 1)))
    (let ((old (symbol-function 'metal-redefined)))
      (eval '(ct:define-kernel metal-redefined (a) (* a 3)))
      (tg:with-device-tensor (result (funcall old a))
        (check-fusion-values '(2 3 4) result))
      (tg:with-device-tensor (result (funcall (symbol-function 'metal-redefined) a))
        (check-fusion-values '(3 6 9) result)))
    (let* ((operation (compile nil '(lambda (a) (ct:fuse (+ a 5)))))
           (threads (loop repeat 4 collect
                      (bordeaux-threads:make-thread (lambda () (funcall operation a))))))
      (dolist (thread threads)
        (tg:with-device-tensor (result (bordeaux-threads:join-thread thread))
          (check-fusion-values '(6 7 8) result))))))

(test metal-fusion-hidden-window-alias-and-rounding
  (tg:with-device-tensor (base (tg:to-device (ct:from-data '(1 2 3 4 5 6 7 8))))
    (let* ((source (gpu:make-gpu-array-view (ct:tensor-storage base) 6))
           (target (gpu:make-gpu-array-view (ct:tensor-storage base) 6 :offset 1))
           (a (ct:make-tensor-view source '(6)))
           (out (ct:make-tensor-view target '(6))))
      (let ((*forbid-download* t)) (ct:fuse! out (+ a 10)))
      (check-fusion-values '(11 12 13 14 15 16) out)
      (check-fusion-values '(1 11 12 13 14 15 16 8) base)))
  (tg:with-device-tensor (a (tg:to-device (ct:from-data '(4097))))
    (tg:with-device-tensor (ordinary (ct:fuse (+ (* a a) -16785408)))
      (check-fusion-values '(0) ordinary))
    (tg:with-device-tensor (contracted (ct:fuse (trivial-simd:fma a a -16785408)))
      (check-fusion-values '(1) contracted))))
