(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu)

(defclass f64-mock-device (mock-device)
  ((native-f64-p :initform t :accessor native-f64-p)))

(defvar *f64-protocol-computation* nil)
(defmethod gpu:device-load :before ((device f64-mock-device) buffer sequence type offset)
  (declare (ignore buffer offset))
  (when *f64-protocol-computation*
    (unless (and (= 1 (length sequence)) (eq type (gpu:parse-type 'gpu:u32)))
      (error "Unexpected tensor download during f64 computation"))))

(defmethod gpu:device-target ((device f64-mock-device)) :opencl)
(defmethod gpu:device-native-type-p ((device f64-mock-device) element)
  (and (native-f64-p device) (eq element 'gpu:f64)))

(defun device-activity (device)
  (list (allocations device) (uploads device) (downloads device) (launches device)))

(test f64-capability-precedes-allocation-and-empty-work
  (let ((device (make-instance 'mock-device)))
    (dolist (shape '(nil (0) (2)))
      (dolist (thunk (list (lambda () (tg:make-device-tensor shape :dtype :f64 :device device))
                          (lambda () (tg:to-device (ct:zeros shape :dtype :f64) :device device))))
        (handler-case (progn (funcall thunk) (fail "Expected missing native f64 capability"))
          (gpu:gpu-unsupported-capability (condition)
            (is (eq device (gpu:unsupported-capability-device condition)))
            (is (member (gpu:unsupported-capability-operation condition) '(:allocate :upload)))
            (is (eq 'gpu:f64 (gpu:unsupported-capability-element-type condition)))))))
    (is (equal '(0 0 0 0) (device-activity device)))
    (gpu:with-gpu-array (raw (gpu:make-gpu-array 0 :element-type 'gpu:f64 :device device))
      (signals gpu:gpu-unsupported-capability (ct:make-tensor-view raw '(0)))))
  (let ((device (make-instance 'f64-mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(0) :device device))
      (let ((before (device-activity device)))
        (setf (native-f64-p device) nil)
        (signals gpu:gpu-unsupported-capability (ct:astype input :f64))
        (is (equal before (device-activity device)))))))

(test f64-storage-transfers-views-and-cleanup
  (let* ((device (make-instance 'f64-mock-device))
         (cpu (ct:from-data '(16777217d0 -1d-200 1d200 4d0) :dtype :f64)))
    (tg:with-device-tensor (input (tg:to-device cpu :device device))
      (is (eq :f64 (ct:storage-dtype (ct:tensor-storage input))))
      (is (= 64 (gpu:scalar-type-bits (gpu:gpu-array-element-type (ct:tensor-storage input)))))
      (is (equal (cl-tensor/tests::tensor-values cpu)
                 (cl-tensor/tests::tensor-values (tg:from-device input))))
      (let ((view (ct:make-tensor-view (ct:tensor-storage input) '(2 2) :strides '(2 -1) :offset 1)))
        (is (eq :f64 (ct:tensor-dtype view)))
        (is (eq (ct:tensor-storage view) (ct:tensor-storage input))))
      (gpu:with-gpu-array (window (gpu:make-gpu-array-view (ct:tensor-storage input) 2 :offset 1))
        (is (eq :f64 (ct:tensor-dtype (ct:make-tensor-view window '(2)))))))
    (tg:with-device-tensor (input (tg:to-device (ct:transpose (ct:reshape cpu '(2 2))) :device device))
      (is (equal '(16777217d0 1d200 -1d-200 4d0)
                 (cl-tensor/tests::tensor-values (tg:from-device input)))))
    (is (= (allocations device) (frees device)))
    (is (typep (ct:tensor-storage (ct:zeros '(2) :dtype :f64)) '(simple-array double-float (*))))))

(test f64-dispatch-precision-families-and-no-downloads
  (let ((device (make-instance 'f64-mock-device))
        (*f64-protocol-computation* t)
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :dtype :f64 :device device))
      (dolist (operation '(ct:add ct:subtract ct:multiply ct:divide ct:min ct:max))
        (tg:with-device-tensor (result (funcall operation input 1.0000000000000002d0))
          (is (eq :f64 (ct:tensor-dtype result)))))
      (dolist (operation '(ct:negate ct:abs ct:sqrt ct:reciprocal ct:exp ct:log ct:sin ct:cos
                          ct:tanh ct:sigmoid ct:silu ct:gelu))
        (tg:with-device-tensor (result (funcall operation input))
          (is (eq :f64 (ct:tensor-dtype result)))))
      (dolist (operation '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax ct:softmax ct:rmsnorm))
        (tg:with-device-tensor (result (funcall operation input :axis #()))
          (is (eq (if (member operation '(ct:argmin ct:argmax)) :s64 :f64) (ct:tensor-dtype result)))))
      (dolist (operation '(ct:sum ct:mean ct:softmax ct:rmsnorm))
        (tg:with-device-tensor (result (funcall operation input :axis #() :accumulate :f64))
          (is (eq :f64 (ct:tensor-dtype result)))))
      (tg:with-device-tensor (mask (ct:compare :gt input 1d0))
        (is (eq :u8 (ct:tensor-dtype mask)))
        (tg:with-device-tensor (result (ct:select mask 1.0000000000000002d0 0d0 :dtype :f64))
          (is (eq :f64 (ct:tensor-dtype result)))))
      (dolist (dtype '(:f32 :f16 :bf16 :s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64))
        (tg:with-device-tensor (result (ct:astype input dtype))
          (tg:with-device-tensor (back (ct:astype result :f64))
            (is (eq :f64 (ct:tensor-dtype back))))))
      (tg:with-device-tensor (copy (ct:copy-tensor input))
        (is (eq :f64 (ct:tensor-dtype copy))))
      (is (= 8 (downloads device))))
    (is (= (allocations device) (frees device)))))

(test f64-unsupported-families-and-capability-loss-do-not-start-work
  (let ((device (make-instance 'f64-mock-device)))
    (dolist (shape '((0) (2)))
      (tg:with-device-tensor (input (tg:make-device-tensor shape :dtype :f64 :device device))
        (tg:with-device-tensor (indices (tg:make-device-tensor '(0) :dtype :s64 :device device))
          (let ((before (device-activity device)))
            (signals ct:unsupported-operation (ct:matmul input input))
            (signals ct:unsupported-operation (ct:take input indices))
            (signals ct:unsupported-operation (ct:fuse (+ input 1d0)))
            (signals error (ct:sum input :accumulate :f32))
            (is (equal before (device-activity device))))
          (setf (native-f64-p device) nil)
          (let ((before (device-activity device)))
            (signals gpu:gpu-unsupported-capability (ct:add input 1d0))
            (signals gpu:gpu-unsupported-capability (ct:sum input))
            (signals gpu:gpu-unsupported-capability (tg:from-device input))
            (signals gpu:gpu-unsupported-capability (ct:copy-tensor input))
            (is (equal before (device-activity device))))
          (setf (native-f64-p device) t))))
    (is (= (allocations device) (frees device)))))

(test f64-failures-release-scratch-and-preserve-destinations
  (let ((device (make-instance 'f64-mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :dtype :f64 :device device))
      (tg:with-device-tensor (out (tg:to-device (ct:from-data '(9d0 8d0) :dtype :f64) :device device))
        (dolist (failure '(:launch :wait))
          (setf (fail-launch device) (eq failure :launch) (fail-wait device) (eq failure :wait))
          (signals error (ct:sum! out input :axis 1))
          (is (= 2 (- (allocations device) (frees device))))
          (setf (fail-launch device) nil (fail-wait device) nil)
          (is (equal '(9d0 8d0) (cl-tensor/tests::tensor-values (tg:from-device out)))))
        (tg:with-device-tensor (weights (tg:make-device-tensor '(3) :device device))
          (let ((before (device-activity device)))
            (signals ct:unsupported-operation (ct:rmsnorm input :weights weights))
            (is (equal before (device-activity device)))))))
    (setf (fail-wait device) t)
    (signals error (tg:make-device-tensor '(2) :dtype :f64 :device device))
    (signals error (tg:to-device (ct:zeros '(2) :dtype :f64) :device device))
    (is (= (allocations device) (frees device)))))

(test f64-owning-and-borrowed-view-lifetimes
  (let ((device (make-instance 'f64-mock-device)) (view nil))
    (tg:with-device-tensor (input (tg:make-device-tensor '(4) :dtype :f64 :device device))
      (setf view (ct:reshape input '(2 2)))
      (is (eq (ct:tensor-storage input) (ct:tensor-storage view))))
    (signals error (tg:from-device view))
    (tg:free-device-tensor view)
    (gpu:with-gpu-array (root (gpu:make-gpu-array 8 :element-type 'gpu:f64 :device device))
      (let* ((window (gpu:make-gpu-array-view root 4 :offset 2))
             (tensor (ct:make-tensor-view window '(2 2) :strides '(2 -1) :offset 1)))
        (tg:free-device-tensor tensor)
        (is (= 8 (ct:storage-length root)))
        (is (eq :f64 (ct:tensor-dtype (ct:make-tensor-view window '(4)))))))
    (is (= (allocations device) (frees device)))))
