(in-package #:cl-tensor)

(defun matmul-promote (tensor left)
  (if (/= (tensor-rank tensor) 1)
      tensor
      (make-tensor-view (tensor-storage tensor)
                        (if left (list 1 (tensor-size tensor)) (list (tensor-size tensor) 1))
                        :dtype (tensor-dtype tensor) :offset (tensor-offset tensor)
                        :strides (if left (list 0 (aref (tensor-strides tensor) 0))
                                     (list (aref (tensor-strides tensor) 0) 0)))))

(defun matmul-batch-view (tensor)
  (let ((rank (- (tensor-rank tensor) 2)))
    ;; Metadata only: empty matrices can have nonempty batches and out-of-storage offsets.
    (%make-tensor (tensor-storage tensor) (tensor-dtype tensor)
                  (subseq (tensor-shape tensor) 0 rank)
                  (subseq (tensor-strides tensor) 0 rank) (tensor-offset tensor))))

(defun matmul-matrix-layout (rows cols rs cs)
  (cond ((and (or (= cols 1) (= cs 1))
              (or (= rows 1) (<= (cl:max 1 cols) rs)))
         (values :row-major (if (= rows 1) (cl:max 1 cols) rs)))
        ((and (or (= rows 1) (= rs 1))
              (or (= cols 1) (<= (cl:max 1 rows) cs)))
         (values :column-major (if (= cols 1) (cl:max 1 rows) cs)))))

(defun matmul-copy-matrix (tensor offset rows cols rs cs buffer scatter)
  (dotimes (i rows)
    (dotimes (j cols)
      (let ((index (+ offset (* i rs) (* j cs))) (position (+ (* i cols) j)))
        (if scatter
            (setf (storage-ref (tensor-storage tensor) index) (aref buffer position))
            (setf (aref buffer position) (storage-ref (tensor-storage tensor) index)))))))

(defun matmul-matrix-adapter (tensor)
  (let* ((axis (- (tensor-rank tensor) 2))
         (rows (aref (tensor-shape tensor) axis))
         (cols (aref (tensor-shape tensor) (1+ axis)))
         (rs (aref (tensor-strides tensor) axis))
         (cs (aref (tensor-strides tensor) (1+ axis))))
    (multiple-value-bind (layout ld) (matmul-matrix-layout rows cols rs cs)
      (when ld
        (unless (typep ld 'trivial-simd/blas::blas-dim)
          (error "Matrix leading dimension exceeds BLAS limits")))
      (let* ((scratch (unless layout
                        (make-array (* rows cols) :element-type (dtype-element-type (tensor-dtype tensor))
                                                 :initial-element (dtype-zero (tensor-dtype tensor)))))
             (transpose (if (eq layout :column-major)
                            :transpose :no-transpose)))
        (values
         (lambda (offset)
           (when scratch
             (matmul-copy-matrix tensor offset rows cols rs cs scratch nil))
           (trivial-simd/blas:make-matrix-view
            (or scratch (tensor-storage tensor))
            (if (eq transpose :transpose) cols rows)
            (if (eq transpose :transpose) rows cols)
            :layout :row-major
            :leading-dimension (or ld (cl:max 1 cols)) :offset (if scratch 0 offset)))
         transpose)))))

(defun matmul-vector-adapter (tensor axis &optional output)
  (let* ((count (aref (tensor-shape tensor) axis))
         (stride (if (= count 1) 1 (aref (tensor-strides tensor) axis)))
         (scratch (when (zerop stride)
                    (when output (error "Matmul output elements overlap"))
                    (make-array count :element-type (dtype-element-type (tensor-dtype tensor)))))
         (increment (if scratch 1 stride)))
    (unless (typep increment 'trivial-simd/blas::blas-increment)
      (error "Vector stride exceeds BLAS limits"))
    (lambda (offset)
      (when scratch (fill scratch (storage-ref (tensor-storage tensor) offset)))
      (values (or scratch (tensor-storage tensor)) increment
              (if scratch 0 (+ offset (if (minusp stride) (* (1- count) stride) 0)))))))

(defun matmul-gemm-adapter (tensor &optional output)
  (let* ((axis (- (tensor-rank tensor) 2))
         (rows (aref (tensor-shape tensor) axis))
         (cols (aref (tensor-shape tensor) (1+ axis)))
         (rs (if (= rows 1) 0 (aref (tensor-strides tensor) axis)))
         (cs (if (= cols 1) 0 (aref (tensor-strides tensor) (1+ axis))))
         (scratch (when (or (not (typep rs 'trivial-simd/blas::blas-increment))
                           (not (typep cs 'trivial-simd/blas::blas-increment)))
                    (make-array (* rows cols) :element-type (dtype-element-type (tensor-dtype tensor))
                                             :initial-element (dtype-zero (tensor-dtype tensor))))))
    (values
     (lambda (offset)
       (when (and scratch (not output))
         (matmul-copy-matrix tensor offset rows cols rs cs scratch nil))
       (trivial-simd/blas:make-matrix-view
        (or scratch (tensor-storage tensor)) rows cols
        :row-stride (if scratch cols rs) :column-stride (if scratch 1 cs)
        :offset (if scratch 0 offset)))
     scratch
     (when (and output scratch)
       (lambda (offset) (matmul-copy-matrix tensor offset rows cols rs cs scratch t))))))

(defun matmul-batch-run (batch layouts)
  (let ((prefix (length batch)) (count 1) (steps (mapcar (constantly 0) layouts)))
    (loop for axis downfrom (1- (length batch)) to 0
          for dimension = (aref batch axis)
          do (cond ((= dimension 1) (setf prefix axis))
                   ((= count 1)
                    (setf steps (mapcar (lambda (layout) (aref layout axis)) layouts)
                          count dimension prefix axis))
                   ((every (lambda (layout step) (= (aref layout axis) (* count step))) layouts steps)
                    (setf count (* count dimension) prefix axis))
                   (t (return))))
    (values prefix count steps)))

(defun matmul-run-matrices (a b out batch layouts offsets)
  (multiple-value-bind (aa ascratch) (matmul-gemm-adapter a)
    (multiple-value-bind (ba bscratch) (matmul-gemm-adapter b)
      (multiple-value-bind (oa oscratch scatter) (matmul-gemm-adapter out t)
        (multiple-value-bind (prefix count steps) (matmul-batch-run batch layouts)
          (let* ((single (eq (tensor-dtype a) :f32))
                 (one (coerce-value 1 (tensor-dtype a))) (zero (dtype-zero (tensor-dtype a)))
                 (gemm (if single #'trivial-simd/blas:sgemm #'trivial-simd/blas:dgemm))
                 (batched (if single #'trivial-simd/blas:sgemm-batch-strided
                                     #'trivial-simd/blas:dgemm-batch-strided)))
            (when (or ascratch bscratch oscratch)
              (setf prefix (length batch) count 1 steps '(0 0 0)))
            (call-with-offsets
             (subseq batch 0 prefix) (mapcar (lambda (layout) (subseq layout 0 prefix)) layouts) offsets
             (lambda (ai bi oi)
               (loop for start from 0 below count by 1073741823
                     for chunk = (cl:min 1073741823 (- count start))
                     for ao = (+ ai (* start (first steps)))
                     for bo = (+ bi (* start (second steps)))
                     for co = (+ oi (* start (third steps)))
                     do (if (= chunk 1)
                            (funcall gemm :no-transpose :no-transpose one
                                     (funcall aa ao) (funcall ba bo) zero (funcall oa co))
                            (funcall batched :no-transpose :no-transpose one
                                     (funcall aa ao) (funcall ba bo) zero (funcall oa co)
                                     :batch-count chunk :a-stride (first steps)
                                     :b-stride (second steps) :c-stride (third steps)))
                        (when scatter (funcall scatter co))))))))))
  out)

(defun matmul-run (a b out batch k left-vector right-vector)
  (let* ((dtype (tensor-dtype a))
         (single (eq dtype :f32))
         (one (coerce-value 1 dtype))
         (zero (dtype-zero dtype))
         (ab (matmul-batch-view a)) (bb (matmul-batch-view b))
         (ob (matmul-batch-view out))
         (layouts (list (broadcast-strides ab batch) (broadcast-strides bb batch)
                        (tensor-strides ob)))
         (offsets (list (tensor-offset a) (tensor-offset b) (tensor-offset out))))
    (unless (or left-vector right-vector)
      (return-from matmul-run (matmul-run-matrices a b out batch layouts offsets)))
    (multiple-value-bind (aa ta)
        (if left-vector
            (matmul-vector-adapter a (1- (tensor-rank a)))
            (matmul-matrix-adapter a))
      (multiple-value-bind (ba tb)
          (if right-vector
              (matmul-vector-adapter b (- (tensor-rank b) 2))
              (matmul-matrix-adapter b))
        (let ((oa (unless (and left-vector right-vector)
                    (matmul-vector-adapter out
                                           (if left-vector (1- (tensor-rank out))
                                               (- (tensor-rank out) 2)) t))))
          (call-with-offsets
           batch layouts offsets
           (lambda (ai bi oi)
             (cond
               ((and left-vector right-vector)
                (multiple-value-bind (av inc-a start-a) (funcall aa ai)
                  (multiple-value-bind (bv inc-b start-b) (funcall ba bi)
                    (setf (storage-ref (tensor-storage out) oi)
                          (funcall (if single #'trivial-simd/blas:sdot #'trivial-simd/blas:ddot)
                                   k av inc-a bv inc-b :x-offset start-a :y-offset start-b)))))
               (t
                (multiple-value-bind (vector increment start)
                    (if left-vector (funcall aa ai) (funcall ba bi))
                  (multiple-value-bind (target target-increment target-start) (funcall oa oi)
                    (funcall (if single #'trivial-simd/blas:sgemv #'trivial-simd/blas:dgemv)
                             (if left-vector
                                 (if (eq tb :transpose) :no-transpose :transpose) ta)
                             one (if left-vector (funcall ba bi) (funcall aa ai))
                             vector increment zero target target-increment
                             :x-offset start :y-offset target-start)))))))))))
  out)

(defvar *encoded-matmul-addresses* nil)

(defun call-with-encoded-matmul-addresses (storages function &optional addresses)
  (if (null storages)
      (let ((*encoded-matmul-addresses* addresses)) (funcall function))
      (let ((storage (first storages)))
        (if (trivial-simd:vector-view-p storage)
            (call-with-encoded-matmul-addresses
             (rest storages) function
             (acons storage (cffi:pointer-address (trivial-simd:vector-view-pointer storage)) addresses))
            (cffi:with-pointer-to-vector-data (pointer storage)
              (call-with-encoded-matmul-addresses
               (rest storages) function (acons storage (cffi:pointer-address pointer) addresses)))))))

(defun encoded-matmul-overlapping-p (a b)
  (if (null *encoded-matmul-addresses*)
      (overlapping-p a b)
      (flet ((span (tensor)
               (multiple-value-bind (low high)
                   (reachable-range (tensor-shape tensor) (tensor-strides tensor) (tensor-offset tensor))
                 (let ((base (cdr (assoc (tensor-storage tensor) *encoded-matmul-addresses*)))
                       (size (dtype-bytes (tensor-dtype tensor))))
                   (values (+ base (* low size)) (+ base (* (1+ high) size)))))))
        (multiple-value-bind (al ah) (span a)
          (multiple-value-bind (bl bh) (span b)
            (and (< al bh) (< bl ah)))))))

(defun encoded-matmul-adapter (tensor transpose &optional output)
  (let* ((axis (- (tensor-rank tensor) 2))
         (rows (aref (tensor-shape tensor) (+ axis (if transpose 1 0))))
         (cols (aref (tensor-shape tensor) (+ axis (if transpose 0 1))))
         (rs (aref (tensor-strides tensor) (+ axis (if transpose 1 0))))
         (cs (aref (tensor-strides tensor) (+ axis (if transpose 0 1))))
         (direct (and (or (= cols 1) (= cs 1)) (or (= rows 1) (>= rs cols))))
         (stride (if direct (if (= rows 1) cols rs) cols))
         (scratch (unless direct
                    (make-array (* rows cols) :element-type (dtype-element-type (tensor-dtype tensor))))))
    (values
     (lambda (offset)
       (when (and scratch (not output))
         (matmul-copy-matrix tensor offset rows cols rs cs scratch nil))
       (values (or scratch (tensor-storage tensor)) (if scratch 0 offset) stride))
     (when (and scratch output)
       (lambda (offset) (matmul-copy-matrix tensor offset rows cols rs cs scratch t))))))

(defun encoded-matmul-run (a b out batch)
  (let* ((encoded-left (member (tensor-dtype a) '(:f16 :bf16)))
         (weights (if encoded-left a b))
         (x (if encoded-left b a))
         (axis (- (tensor-rank x) 2))
         (n (aref (tensor-shape x) (+ axis (if encoded-left 1 0))))
         (k (aref (tensor-shape x) (+ axis (if encoded-left 0 1))))
         (m (aref (tensor-shape weights) (+ (- (tensor-rank weights) 2) (if encoded-left 0 1))))
         (function (if (eq (tensor-dtype weights) :f16)
                       #'trivial-simd:f16-matmul! #'trivial-simd:bf16-matmul!)))
    (multiple-value-bind (wa) (encoded-matmul-adapter weights (not encoded-left))
      (multiple-value-bind (xa) (encoded-matmul-adapter x encoded-left)
        (multiple-value-bind (oa scatter) (encoded-matmul-adapter out encoded-left t)
          (call-with-offsets
           batch (list (broadcast-strides (matmul-batch-view weights) batch)
                       (broadcast-strides (matmul-batch-view x) batch)
                       (tensor-strides (matmul-batch-view out)))
           (list (tensor-offset weights) (tensor-offset x) (tensor-offset out))
           (lambda (wi xi oi)
             (multiple-value-bind (w ws wstride) (funcall wa wi)
               (multiple-value-bind (x xs xstride) (funcall xa xi)
                 (multiple-value-bind (o os ostride) (funcall oa oi)
                   (funcall function o x w n m k :weights-start ws :weights-stride wstride
                            :x-start xs :x-stride xstride :out-start os :out-stride ostride))))
             (when scatter (funcall scatter oi))))))))
  out)

(defun parallel-matmul-run (a b out batch left-vector right-vector)
  (let* ((ar (- (tensor-rank a) 2)) (br (- (tensor-rank b) 2))
         (m (aref (tensor-shape a) ar)) (k (aref (tensor-shape a) (1+ ar)))
         (n (aref (tensor-shape b) (1+ br)))
         (groups (if left-vector n m))
         (a-layout (broadcast-strides (matmul-batch-view a) batch))
         (b-layout (broadcast-strides (matmul-batch-view b) batch))
         (out-layout (tensor-strides (matmul-batch-view out))))
    (call-with-operation-ranges
     (* groups (reduce #'* batch))
     (lambda (start end)
       (let ((*encoded-matmul-addresses* nil))
         (loop while (< start end)
               do (multiple-value-bind (batch-index row) (floor start groups)
                    (let* ((count (cl:min (- end start) (- groups row)))
                           (ao (linear-layout-offset batch-index batch a-layout (tensor-offset a)))
                           (bo (linear-layout-offset batch-index batch b-layout (tensor-offset b)))
                           (oo (linear-layout-offset batch-index batch out-layout (tensor-offset out)))
                           (aa (if left-vector
                                   (layout-view a (list k) (list (aref (tensor-strides a) (1+ ar))) ao)
                                   (layout-view a (list count k)
                                                (subseq (tensor-strides a) ar)
                                                (+ ao (* row (aref (tensor-strides a) ar))))))
                           (bb (cond (right-vector
                                      (layout-view b (list k) (list (aref (tensor-strides b) br)) bo))
                                     (left-vector
                                      (layout-view b (list k count) (subseq (tensor-strides b) br)
                                                   (+ bo (* row (aref (tensor-strides b) (1+ br))))))
                                     (t (layout-view b (list k n) (subseq (tensor-strides b) br) bo))))
                           (output-axis (- (tensor-rank out) 2))
                           (output (cond
                                     (left-vector
                                      (layout-view out (list count)
                                                   (list (aref (tensor-strides out) (1+ output-axis)))
                                                   (+ oo (* row (aref (tensor-strides out) (1+ output-axis))))))
                                     (right-vector
                                      (layout-view out (list count)
                                                   (list (aref (tensor-strides out) output-axis))
                                                   (+ oo (* row (aref (tensor-strides out) output-axis)))))
                                     (t (layout-view out (list count n)
                                                     (subseq (tensor-strides out) output-axis)
                                                     (+ oo (* row (aref (tensor-strides out) output-axis))))))))
                      (builtin-tensor-matmul aa bb output)
                      (incf start count)))))))))

(defun builtin-tensor-matmul (a b out)
  (check-type a tensor)
  (check-type b tensor)
  (when out (check-type out tensor))
  (unless (and (plusp (tensor-rank a)) (plusp (tensor-rank b)))
    (error "Matmul operands must have rank at least one"))
  (unless (or (and (member (tensor-dtype a) '(:f32 :f64))
                   (eq (tensor-dtype a) (tensor-dtype b)))
              (and (eq (tensor-dtype a) :f32) (member (tensor-dtype b) '(:f16 :bf16)))
              (and (eq (tensor-dtype b) :f32) (member (tensor-dtype a) '(:f16 :bf16))))
    (error "Matmul requires matching f32/f64 or one encoded operand and one f32 operand"))
  (let* ((encoded (or (member (tensor-dtype a) '(:f16 :bf16))
                       (member (tensor-dtype b) '(:f16 :bf16))))
         (result-dtype (if encoded :f32 (tensor-dtype a)))
         (left-vector (= (tensor-rank a) 1))
         (right-vector (= (tensor-rank b) 1))
         (ap (matmul-promote a t)) (bp (matmul-promote b nil))
         (ar (- (tensor-rank ap) 2)) (br (- (tensor-rank bp) 2))
         (m (aref (tensor-shape ap) ar)) (k (aref (tensor-shape ap) (1+ ar)))
         (n (aref (tensor-shape bp) (1+ br)))
         (batch (broadcast-shape (list (matmul-batch-view ap) (matmul-batch-view bp))))
         (shape (index-vector (append (coerce batch 'list)
                                     (unless left-vector (list m)) (unless right-vector (list n))))))
    (unless (= k (aref (tensor-shape bp) br))
      (error "Matmul contraction dimensions must match"))
    (unless (every (lambda (dimension) (typep dimension 'trivial-simd/blas::blas-dim)) (list m k n))
      (error "Matmul dimensions exceed BLAS limits"))
    (let ((result (or out (make-tensor shape :dtype result-dtype))))
      (unless (and (equalp shape (tensor-shape result)) (eq result-dtype (tensor-dtype result)))
        (error "Matmul output must have shape ~S and dtype ~S" shape result-dtype))
      (unless (unique-output-p result) (error "Matmul output elements overlap"))
      (when (zerop (tensor-size result)) (return-from builtin-tensor-matmul result))
      (when (zerop k)
        (call-with-offsets shape (list (tensor-strides result)) (list (tensor-offset result))
                           (lambda (index)
                             (setf (storage-ref (tensor-storage result) index) (dtype-zero result-dtype))))
        (return-from builtin-tensor-matmul result))
      (dolist (tensor (list a b result))
        (multiple-value-bind (low high)
            (reachable-range (tensor-shape tensor) (tensor-strides tensor) (tensor-offset tensor))
          (declare (ignore low))
          (unless (typep high 'trivial-simd/blas::blas-offset)
            (error "Matmul storage offsets exceed BLAS limits"))))
      (flet ((execute ()
                 (when (funcall (if encoded #'encoded-matmul-overlapping-p #'overlapping-p) result a)
                   (setf ap (matmul-promote (copy-tensor a) t)))
                 (when (funcall (if encoded #'encoded-matmul-overlapping-p #'overlapping-p) result b)
                   (setf bp (matmul-promote (copy-tensor b) nil)))
                 (let* ((strides (coerce (tensor-strides result) 'list))
                        (batch-rank (length batch))
                        (matrix-strides (append (subseq strides 0 batch-rank)
                                                (list (if left-vector 0 (nth batch-rank strides))
                                                      (if right-vector 0 (car (last strides))))))
                        (output (make-tensor-view (tensor-storage result)
                                                  (append (coerce batch 'list) (list m n))
                                                  :dtype (tensor-dtype result) :offset (tensor-offset result)
                                                  :strides matrix-strides)))
                   (cond ((and *executor* (not (and left-vector right-vector)))
                          (parallel-matmul-run ap bp output batch left-vector right-vector))
                         (encoded (encoded-matmul-run ap bp output batch))
                         (t (matmul-run ap bp output batch k left-vector right-vector))))))
        #+(or sbcl ccl ecl)
        (if encoded
            (call-with-encoded-matmul-addresses
             (remove-duplicates (mapcar #'tensor-storage (list a b result)) :test #'eq) #'execute)
            (execute))
        #-(or sbcl ccl ecl)
        (execute))
      result)))

(defun matmul-result-shape (a b)
  (let* ((as (tensor-shape a)) (bs (tensor-shape b))
         (ar (length as)) (br (length bs))
         (av (= ar 1)) (bv (= br 1)))
    (unless (and (plusp ar) (plusp br))
      (error "Matmul operands must have rank at least one"))
    (unless (= (aref as (1- ar)) (aref bs (if bv 0 (- br 2))))
      (error "Matmul contraction dimensions must match"))
    (let* ((ab (if av #() (subseq as 0 (- ar 2))))
           (bb (if bv #() (subseq bs 0 (- br 2))))
           (rank (cl:max (length ab) (length bb)))
           (batch (make-array rank :element-type 'fixnum :initial-element 1)))
      (dolist (shape (list ab bb))
        (loop for d across shape for axis from (- rank (length shape))
              for current = (aref batch axis)
              do (cond ((= d current)) ((= current 1) (setf (aref batch axis) d))
                       ((/= d 1) (error "Incompatible broadcast shapes")))))
      (index-vector (append (coerce batch 'list)
                            (unless av (list (aref as (- ar 2))))
                            (unless bv (list (aref bs (1- br)))))))))

(defun tensor-matmul (a b out)
  (check-type a tensor)
  (check-type b tensor)
  (when out (check-type out tensor))
  (labels ((shape () (matmul-result-shape a b))
           (fallback (target inputs)
             (builtin-tensor-matmul (first inputs) (second inputs) target))
           (matrix-dispatch (target inputs)
             (dispatch-operation :matmul target inputs nil #'shape #'fallback)))
    (if (and (= 1 (tensor-rank a)) (= 1 (tensor-rank b)))
        (dispatch-operation :dot out (list a b) nil #'shape #'matrix-dispatch t)
        (matrix-dispatch out (list a b)))))

(defun matmul (a b)
  (tensor-matmul a b nil))

(defun matmul! (out a b)
  (check-type out tensor)
  (tensor-matmul a b out))
