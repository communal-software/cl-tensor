(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu/metal)

(defun f32-bits (value)
  (cffi:with-foreign-object (pointer :float)
    (setf (cffi:mem-ref pointer :float) value)
    (cffi:mem-ref pointer :uint32)))

(defparameter *elementwise-cases*
  '((ct:add 2) (ct:subtract 2) (ct:multiply 2) (ct:divide 2)
    (ct:min 1) (ct:max 1) (ct:clamp 0 1)
    (ct:negate) (ct:abs) (ct:sqrt) (ct:reciprocal) (ct:exp) (ct:log)
    (ct:sin) (ct:cos) (ct:tanh) (ct:sigmoid) (ct:silu) (ct:gelu)))

(test metal-elementwise-layouts-destinations-and-aliases
  (let ((base (ct:from-data (loop for i below 40 collect (+ 0.2f0 (* 0.1f0 (mod i 13)))))))
    (tg:with-device-tensor (device-base (tg:to-device base))
      (dolist (layout '(((2 3) (3 1) 0) ((3 2) (1 3) 0) ((2 3) (3 -1) 2)
                        ((2 3) (12 2) 1) ((2 3) (0 1) 0)))
        (destructuring-bind (shape strides offset) layout
          (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) shape :strides strides :offset offset))
                 (input (mirror-view cpu (ct:tensor-storage device-base))))
            (dolist (case *elementwise-cases*)
              (destructuring-bind (operation &rest args) case
                (let ((expected (apply operation cpu args)))
                  (tg:with-device-tensor (result (let ((*forbid-download* t)) (apply operation input args)))
                    (is (same-values-p expected (tg:from-device result))))
                  (tg:with-device-tensor (backing (tg:to-device (ct:full '(20) 77)))
                    (let ((out (ct:make-tensor-view (ct:tensor-storage backing) shape
                                                    :strides (mapcar (lambda (s) (* -2 s))
                                                                     (coerce (ct:row-major-strides shape) 'list))
                                                    :offset 10)))
                      (is (eq out (let ((*forbid-download* t))
                                    (apply (out-operation operation) out input args))))
                      (is (same-values-p expected (tg:from-device out))))
                    (let ((values (host-values (tg:from-device backing))))
                      (is (every (lambda (i) (= 77 (nth i values))) '(1 3 5 7 9 11 12 13 14 15 16 17 18 19))))))))))))
    (dolist (case *elementwise-cases*)
      (destructuring-bind (operation &rest args) case
        (dolist (offset '(0 1))
          (tg:with-device-tensor (backing (tg:to-device base))
            (let* ((input (ct:make-tensor-view (ct:tensor-storage backing) '(2 3)))
                   (out (ct:make-tensor-view (ct:tensor-storage backing) '(2 3) :offset offset))
                   (expected (apply operation (ct:make-tensor-view (ct:tensor-storage base) '(2 3)) args)))
              (let ((*forbid-download* t)) (apply (out-operation operation) out input args))
              (is (same-values-p expected (tg:from-device out))))))))))

(test metal-broadcast-masks-and-scalar-only-calls
  (let ((a (ct:from-data '((1) (2)))) (b (ct:from-data '(1 2 3))))
    (tg:with-device-tensor (da (tg:to-device a))
      (tg:with-device-tensor (db (tg:to-device b))
        (tg:with-device-tensor (result (let ((*forbid-download* t)) (ct:add da db)))
          (is (same-values-p (ct:add a b) (tg:from-device result))))
        (dolist (operator '(:eq :ne :lt :le :gt :ge))
          (tg:with-device-tensor (mask (let ((*forbid-download* t)) (ct:compare operator da db)))
            (is (same-values-p (ct:compare operator a b) (tg:from-device mask)))
            (tg:with-device-tensor (selected (let ((*forbid-download* t)) (ct:select mask da db)))
              (is (same-values-p (ct:select (ct:compare operator a b) a b) (tg:from-device selected)))))))))
  (tg:with-device-tensor (mask (tg:to-device (ct:from-data '(0 2 255) :dtype :u8)))
    (tg:with-device-tensor (selected (let ((*forbid-download* t)) (ct:select mask 7 -2 :dtype :s16)))
      (is (equal '(-2 7 7) (host-values (tg:from-device selected)))))
    (tg:with-device-tensor (out (tg:make-device-tensor '(3) :dtype :s32))
      (let ((*forbid-download* t)) (ct:select! out mask 3 5))
      (is (equal '(5 3 3) (host-values (tg:from-device out))))))
  (tg:with-device-tensor (out (tg:make-device-tensor nil))
    (let ((*forbid-download* t)) (ct:add! out 2 3))
    (is (= 5 (ct:tref (tg:from-device out)))))
  (tg:with-device-tensor (out (tg:make-device-tensor nil :dtype :u8))
    (let ((*forbid-download* t)) (ct:compare! out :gt 3 2))
    (is (= 1 (ct:tref (tg:from-device out))))))

(test metal-integer-arithmetic-and-conversion
  (dolist (dtype *numeric-device-dtypes*)
    (let ((cpu (ct:from-data '(1 2 3 4) :dtype dtype)))
      (tg:with-device-tensor (input (tg:to-device cpu))
        (dolist (case '((ct:add 2) (ct:subtract 2) (ct:multiply 3) (ct:divide 2)
                        (ct:negate) (ct:abs) (ct:min 2) (ct:max 2) (ct:clamp 1 3)))
          (destructuring-bind (operation &rest args) case
            (tg:with-device-tensor (result (let ((*forbid-download* t) (*allow-status-download* t))
                                             (apply operation input args)))
              (is (same-values-p (apply operation cpu args) (tg:from-device result))))))
        (dolist (target *numeric-device-dtypes*)
          (tg:with-device-tensor (result (let ((*forbid-download* t) (*allow-status-download* t))
                                           (ct:astype input target)))
            (is (same-values-p (ct:astype cpu target) (tg:from-device result))))))))
  (dolist (dtype '(:s8 :u8 :s16 :u16 :s32 :u32 :s64 :u64))
    (let* ((signed (member dtype '(:s8 :s16 :s32 :s64)))
           (bits (* 8 (ct:dtype-bytes dtype)))
           (high (1- (expt 2 (if signed (1- bits) bits))))
           (low (if signed (- (expt 2 (1- bits))) 0)))
      (tg:with-device-tensor (input (tg:to-device (ct:from-data (list high low) :dtype dtype)))
        (tg:with-device-tensor (result (ct:add input 1))
          (is (equal (list low (1+ low)) (host-values (tg:from-device result))))))))
  (let ((cpu (ct:from-data '(-2.5 -1.5 -0.1 0.1 1.5 2.5 500))))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (dolist (rounding '(:nearest-even :truncate :floor :ceiling))
        (dolist (target '(:s8 :u8 :s64 :u64))
          (tg:with-device-tensor (result (let ((*forbid-download* t) (*allow-status-download* t))
                                           (ct:astype input target :rounding rounding)))
            (is (same-values-p (ct:astype cpu target :rounding rounding) (tg:from-device result)))))))))

(test metal-encoded-storage-bits-layouts-and-conversion
  (dolist (dtype '(:f16 :bf16))
    (let* ((bits (make-array 65536 :element-type '(unsigned-byte 16)))
           (cpu (ct:make-tensor-view bits '(256 256) :dtype dtype)))
      (dotimes (i 65536) (setf (aref bits i) i))
      (tg:with-device-tensor (input (tg:to-device cpu))
        (is (equalp bits (ct:tensor-storage (tg:from-device input))))
        (dolist (view (list input (ct:transpose input)
                            (ct:make-tensor-view (ct:tensor-storage input) '(256 256)
                                                 :dtype dtype :strides '(256 -1) :offset 255)))
          (tg:with-device-tensor (copy (let ((*forbid-download* t)) (ct:copy-tensor view)))
            (is (equalp (ct:tensor-storage (tg:from-device view))
                        (ct:tensor-storage (tg:from-device copy)))))
          (tg:with-device-tensor (copy (let ((*forbid-download* t)) (ct:astype view dtype)))
            (is (equalp (ct:tensor-storage (tg:from-device view))
                        (ct:tensor-storage (tg:from-device copy))))))
        (let* ((window (gpu:make-gpu-array-view (ct:tensor-storage input) 10 :offset 100))
               (view (ct:make-tensor-view window '(3) :dtype dtype :strides '(-2) :offset 6)))
          (is (equal '(106 104 102) (host-values (tg:from-device view))))))))
  (let ((cpu (ct:from-data '(-65520f0 -1.0005f0 -0f0 0f0 0.00000003f0 1.0005f0 65520f0))))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (dolist (target '(:f16 :bf16))
        (dolist (rounding '(:nearest-even :truncate :floor :ceiling))
          (tg:with-device-tensor (encoded (let ((*forbid-download* t)) (ct:astype input target :rounding rounding)))
            (is (equalp (ct:tensor-storage (ct:astype cpu target :rounding rounding))
                        (ct:tensor-storage (tg:from-device encoded))))
            (tg:with-device-tensor (decoded (let ((*forbid-download* t)) (ct:dequantize encoded)))
              (is (equal (mapcar #'f32-bits (host-values (ct:dequantize (ct:astype cpu target :rounding rounding))))
                         (mapcar #'f32-bits (host-values (tg:from-device decoded))))))))))))

(test metal-elementwise-errors-preserve-destinations
  (dolist (dtype '(:s32 :u64))
    (tg:with-device-tensor (input (tg:to-device (ct:from-data '(2 3 4) :dtype dtype)))
      (tg:with-device-tensor (divisor (tg:to-device (ct:from-data '(1 0 2) :dtype dtype)))
        (tg:with-device-tensor (out (tg:to-device (ct:full '(3) 77 :dtype dtype)))
          (let ((*forbid-download* t) (*allow-status-download* t))
            (signals gpu:gpu-error (ct:divide! out input divisor)))
          (is (equal '(77 77 77) (host-values (tg:from-device out))))))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '(1 2 3))))
    (tg:with-device-tensor (lower (tg:to-device (ct:from-data '(0 3 0))))
      (tg:with-device-tensor (out (tg:to-device (ct:full '(3) 77)))
        (let ((*forbid-download* t) (*allow-status-download* t))
          (signals gpu:gpu-error (ct:clamp! out input lower 2)))
        (is (equal '(77f0 77f0 77f0) (host-values (tg:from-device out))))))))

(test metal-nan-conversion-and-independent-rounding-references
  (let* ((bits (make-array 3 :element-type '(unsigned-byte 16) :initial-contents '(#x7e01 #xfc00 #x8000)))
         (cpu (ct:make-tensor-view bits '(3) :dtype :f16)))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (tg:with-device-tensor (decoded (ct:astype input :f32))
        (is (equal '(#x7fc02000 #xff800000 #x80000000)
                   (mapcar #'f32-bits (host-values (tg:from-device decoded)))))
        (let ((*forbid-download* t) (*allow-status-download* t))
          (signals gpu:gpu-error (ct:astype decoded :s32))))))
  (dolist (case '((:s64 (9223371487098961920 -9223372036854775808) (#x5effffff #xdf000000))
                  (:u64 (18446744073709551615 16777217) (#x5f800000 #x4b800000))))
    (destructuring-bind (dtype values expected) case
      (tg:with-device-tensor (input (tg:to-device (ct:from-data values :dtype dtype)))
        (tg:with-device-tensor (result (let ((*forbid-download* t)) (ct:astype input :f32)))
          (is (equal expected (mapcar #'f32-bits (host-values (tg:from-device result))))))))))

(test metal-elementwise-windows-mask-aliases-and-empty-calls
  (tg:with-device-tensor (backing (tg:to-device (ct:from-data '(77 77 1 2 3 4 5 6 77 77))))
    (let* ((window (gpu:make-gpu-array-view (ct:tensor-storage backing) 6 :offset 2))
           (input (ct:make-tensor-view window '(2 3) :strides '(3 -1) :offset 2))
           (out (ct:make-tensor-view window '(2 3))))
      (let ((*forbid-download* t)) (ct:add! out input 10))
      (is (equal '(77f0 77f0 13f0 12f0 11f0 16f0 15f0 14f0 77f0 77f0)
                 (host-values (tg:from-device backing))))))
  (tg:with-device-tensor (mask (tg:to-device (ct:from-data '(0 2 255) :dtype :u8)))
    (let ((*forbid-download* t)) (ct:select! mask mask 7 3))
    (is (equal '(3 7 7) (host-values (tg:from-device mask))))
    (let ((*forbid-download* t)) (ct:compare! mask :gt mask 5))
    (is (equal '(0 1 1) (host-values (tg:from-device mask)))))
  (tg:with-device-tensor (empty (tg:make-device-tensor '(2 0 3)))
    (tg:with-device-tensor (sum (let ((*forbid-download* t)) (ct:add empty 2)))
      (is (equalp #(2 0 3) (ct:tensor-shape sum))))
    (tg:with-device-tensor (converted (let ((*forbid-download* t)) (ct:astype empty :u64)))
      (is (zerop (ct:tensor-size (tg:from-device converted)))))))
