(in-package #:cl-tensor/gpu)

(defparameter *elementwise-operations*
  '((:add . ew:add!) (:subtract . ew:subtract!) (:multiply . ew:multiply!)
    (:divide . ew:divide!) (:min . ew:min!) (:max . ew:max!)
    (:negate . ew:negate!) (:abs . ew:abs!) (:sqrt . ew:sqrt!)
    (:reciprocal . ew:reciprocal!) (:exp . ew:exp!) (:log . ew:log!)
    (:sin . ew:sin!) (:cos . ew:cos!) (:tanh . ew:tanh!)
    (:sigmoid . ew:sigmoid!) (:silu . ew:silu!) (:gelu . ew:gelu!)
    (:clamp . ew:clamp!) (:compare . ew:compare!) (:select . ew:select!)))

(defun validate-device-operands (device out inputs)
  (dolist (tensor (append (remove-if-not #'ct:tensorp inputs) (when out (list out))))
    (unless (and (typep (ct:tensor-storage tensor) 'gpu:gpu-array)
                 (eq (tensor-device tensor) device))
      (error "GPU operations require tensors on one device; transfer tensors explicitly"))
    (tensor-view tensor)))

(defun device-elementwise (operation result inputs options)
  (let* ((numeric (if (eq operation :select) (rest inputs) inputs))
         (temporary nil))
    (unwind-protect
         (progn
           (unless (find-if #'ct:tensorp numeric)
             (setf temporary (to-device (ct:full nil (first numeric) :dtype (ct:tensor-dtype result))
                                        :device (tensor-device result))
                   inputs (append (when (eq operation :select) (list (first inputs)))
                                  (cons temporary (rest numeric)))))
           (apply (cdr (assoc operation *elementwise-operations*))
                  (tensor-view result)
                  (append (when (eq operation :compare) (list (getf options :operator)))
                          (mapcar (lambda (input) (if (ct:tensorp input) (tensor-view input) input)) inputs)))
           (gpu:synchronize (tensor-device result))
           result)
      (when temporary (free-device-tensor temporary)))))

(defun resolve-device-elementwise (storage operation out inputs options)
  (let ((device (gpu:gpu-array-device storage)))
    (validate-device-operands device out inputs)
    ;; TODO: full-result staging; add measured safe direct selectors (#22).
    (if (member operation '(:convert :dequantize))
        (let ((source (ct:tensor-dtype (first inputs))) (target (getf options :dtype)))
          (device-element source)
          (device-element target)
          (when (or (member source '(:f16 :bf16)) (member target '(:f16 :bf16)))
            (unless (and (member source '(:f16 :bf16 :f32)) (member target '(:f16 :bf16 :f32)))
              (error "Encoded conversion requires real floats or encoded storage")))
          (values target
                  (lambda (result operands parameters)
                    (ew:convert! (tensor-view result) (tensor-view (first operands))
                                 :rounding (getf parameters :rounding :nearest-even))
                    (gpu:synchronize device)
                    result)))
        (multiple-value-bind (shape dtype prepared)
            (ct::prepare-elementwise operation out inputs (getf options :dtype) (getf options :operator))
          (declare (ignore shape))
          (device-element dtype)
          (values dtype
                  (lambda (result operands parameters)
                    (declare (ignore operands))
                    (device-elementwise operation result prepared parameters)))))))
