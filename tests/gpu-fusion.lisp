(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu)

(ct:define-kernel gpu-fusion-affine (a b c unused) (+ (* a b) c))
(ct:define-kernel gpu-fusion-sum (a) (ct:sum a))

(defclass fusion-mock-device (mock-device)
  ((lock :initform (bordeaux-threads:make-lock "mock allocations") :reader fusion-mock-lock)
   (preparations :initform 0 :accessor fusion-preparations)
   (fail-prepare :initform nil :accessor fusion-fail-prepare)))

(defmethod gpu:device-allocate :around ((device fusion-mock-device) bytes)
  (bordeaux-threads:with-lock-held ((fusion-mock-lock device)) (call-next-method)))
(defmethod gpu:device-free :around ((device fusion-mock-device) buffer)
  (bordeaux-threads:with-lock-held ((fusion-mock-lock device)) (call-next-method)))

(defmethod gpu:device-prepare :before ((device fusion-mock-device) source entry &key precise-math)
  (declare (ignore source entry))
  (assert precise-math)
  (incf (fusion-preparations device))
  (when (fusion-fail-prepare device) (error "Injected compilation failure")))

(test fusion-device-dispatch-and-reuse
  (let ((device (make-instance 'fusion-mock-device))
        (ct:*executor* (lambda (&rest args) (declare (ignore args)) (error "CPU executor used"))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (flet ((operation (a b c) (ct:fuse (+ (* a b) c))))
        (tg:with-device-tensor (result (operation input 2 1))
          (is (eq device (tg::tensor-device result)))
          (is (equalp #(2 3) (ct:tensor-shape result))))
        (let ((prepared (fusion-preparations device)))
          (tg:with-device-tensor (result (operation (ct:transpose input) 3 4))
            (is (equalp #(3 2) (ct:tensor-shape result))))
          (is (= prepared (fusion-preparations device)))))
      (tg:with-device-tensor (result (gpu-fusion-affine input 2 1 (ct:ones '(99))))
        (is (eq :f32 (ct:tensor-dtype result))))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2 3) :device device))
        (is (eq out (gpu-fusion-affine! out input 2 1 nil)))
        (is (eq out (ct:fuse! out (+ input 1)))))
      (tg:with-device-tensor (index (ct:fuse (ct:argmin input) :axis -1))
        (is (eq :s64 (ct:tensor-dtype index)))
        (is (equalp #(2) (ct:tensor-shape index))))
      (tg:with-device-tensor (sum (gpu-fusion-sum input :axis #() :keepdims t))
        (is (equalp #(2 3) (ct:tensor-shape sum)))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test fusion-validation-before-device-work
  (let ((device (make-instance 'fusion-mock-device)) (other (make-instance 'fusion-mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(0 3) :device device))
      (let ((cpu (ct:zeros '(0 3))) (before (launches device)))
        (signals error (ct:fuse (+ cpu input)))
        (signals error (ct:fuse (+ input cpu)))
        (signals error (ct:fuse! cpu input))
        (signals error (ct:fuse! input cpu))
        (signals error (ct:fuse! input 1))
        (signals error (ct:fuse (+ input 1) :keepdims t))
        (signals error (ct:fuse (ct:sum input) :axis '(0 0)))
        (signals error (ct:fuse (ct:sum input) :axis 2))
        (tg:with-device-tensor (foreign (tg:make-device-tensor '(0 3) :device other))
          (signals error (ct:fuse (+ input foreign)))
          (signals error (ct:fuse! foreign input)))
        (is (= before (launches device))))
      (tg:with-device-tensor (result (ct:fuse (+ input 1)))
        (is (equalp #(0 3) (ct:tensor-shape result)))))
    (dolist (dtype '(:f16 :bf16 :s32))
      (tg:with-device-tensor (input (tg:make-device-tensor '(0) :dtype dtype :device device))
        (signals error (ct:fuse (+ input 1)))))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2) :device device))
      (tg:with-device-tensor (backing (tg:make-device-tensor '(4) :device device))
        (signals error (ct:fuse! backing input))
        (let ((out (ct:make-tensor-view (ct:tensor-storage backing) '(2) :strides '(0))))
          (signals error (ct:fuse! out input)))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test fusion-device-failure-cleanup-and-retry
  (let ((device (make-instance 'fusion-mock-device)))
    (tg:with-device-tensor (input (tg:make-device-tensor '(2 3) :device device))
      (tg:with-device-tensor (out (tg:make-device-tensor '(2 3) :device device))
        (flet ((operation () (ct:fuse! out (+ input 2))))
          (dolist (failure '(:compile :launch :wait))
            (setf (fusion-fail-prepare device) (eq failure :compile)
                  (fail-launch device) (eq failure :launch)
                  (fail-wait device) (eq failure :wait))
            (signals error (operation))
            (is (= 2 (- (allocations device) (frees device))))
            (setf (fusion-fail-prepare device) nil (fail-launch device) nil (fail-wait device) nil)
            (is (eq out (operation)))))))
    (is (zerop (downloads device)))
    (is (= (allocations device) (frees device)))))

(test fusion-concurrent-first-use-and-redefinition
  (let* ((device (make-instance 'fusion-mock-device))
         (operation (compile nil '(lambda (a) (ct:fuse (+ (* a 2) 1))))))
    (tg:with-device-tensor (a (tg:make-device-tensor '(2 3) :device device))
      (let* ((gate (bordeaux-threads:make-lock "fusion test start"))
             (threads
               (bordeaux-threads:with-lock-held (gate)
                 (loop repeat 4 collect
                   (bordeaux-threads:make-thread
                    (lambda ()
                      (bordeaux-threads:with-lock-held (gate))
                      (funcall operation a)))))))
        (unwind-protect
             (dolist (thread threads)
               (tg:with-device-tensor (result (bordeaux-threads:join-thread thread))
                 (is (equalp #(2 3) (ct:tensor-shape result)))))
          (dolist (thread threads)
            (when (bordeaux-threads:thread-alive-p thread) (bordeaux-threads:join-thread thread)))))
      (is (= 1 (fusion-preparations device)))
      (eval '(ct:define-kernel gpu-redefined (a) (+ a 1)))
      (let ((old (symbol-function 'gpu-redefined)))
        (eval '(ct:define-kernel gpu-redefined (a) (* a 3)))
        (tg:with-device-tensor (result (funcall old a))
          (is (eq device (tg::tensor-device result))))
        (tg:with-device-tensor (result (funcall (symbol-function 'gpu-redefined) a))
          (is (eq device (tg::tensor-device result))))))
    (is (= (allocations device) (frees device)))))

(test fusion-axis-cache-and-allocating-failures
  (let ((device (make-instance 'fusion-mock-device)))
    (tg:with-device-tensor (a (tg:make-device-tensor '(2 3) :device device))
      (flet ((operation (axis keepdims) (ct:fuse (ct:sum a) :axis axis :keepdims keepdims)))
        (tg:with-device-tensor (result (operation -1 nil))
          (is (equalp #(2) (ct:tensor-shape result))))
        (let ((prepared (fusion-preparations device)))
          (tg:with-device-tensor (result (operation 0 t))
            (is (equalp #(1 3) (ct:tensor-shape result))))
          (tg:with-device-tensor (result (operation #() nil))
            (is (equalp #(2 3) (ct:tensor-shape result))))
          (is (= prepared (fusion-preparations device)))))
      (dolist (failure '(:compile :launch :wait))
        (let ((operation (compile nil '(lambda (a) (ct:fuse (+ a 5))))))
          (setf (fusion-fail-prepare device) (eq failure :compile)
                (fail-launch device) (eq failure :launch)
                (fail-wait device) (eq failure :wait))
          (signals error (funcall operation a))
          (is (= 1 (- (allocations device) (frees device))))
          (setf (fusion-fail-prepare device) nil (fail-launch device) nil (fail-wait device) nil))))
    (is (= (allocations device) (frees device)))))

(defclass fusion-unsupported-device (mock-device) ())
(defmethod gpu:device-target ((device fusion-unsupported-device)) :unsupported)

(test fusion-unsupported-backend-is-explicit
  (let ((device (make-instance 'fusion-unsupported-device)))
    (tg:with-device-tensor (a (tg:make-device-tensor '(0) :device device))
      (signals gpu:gpu-error (ct:fuse (+ a 1)))
      (is (zerop (launches device))))
    (is (= (allocations device) (frees device)))))
