(require :asdf)
(load "/Users/george/quicklisp/setup.lisp")
(asdf:initialize-source-registry '(:source-registry (:directory "/Users/george/git/cl-inference/") (:directory "/Users/george/git/cl-tensor/") (:directory "/Users/george/git/trivial-simd/") :inherit-configuration))
(asdf:load-system :cl-inference/local/acceptance)
(defpackage #:copy-inference-bench (:use #:cl) (:local-nicknames (#:local #:cl-inference/local) (#:ct #:cl-tensor) (#:accept #:cl-inference/acceptance) (#:tests #:cl-inference/local/tests)))
(in-package #:copy-inference-bench)
(when (equal "before" (uiop:getenv "COPY_VARIANT"))
  (setf (symbol-function 'ct::copy-vector-runs) (lambda (out input) (declare (ignore out input)) nil)))
(defvar *result*)
(defun measure (kind model function &optional prepare)
  (let ((times nil))
    (dotimes (i 4)
      (when prepare (funcall prepare))
      (sb-ext:gc :full t)
      (let ((start (get-internal-real-time)))
        (setf *result* (funcall function))
        (when (plusp i)
          (push (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second)) times))))
    (format t "~&RESULT,~A,~A,~,4F~%" model kind (second (sort times #'<)))
    (finish-output)))
(dolist (kind '(:qwen-f16 :qwen-q8))
  (assert (accept::verified-model-p kind))
  (local:with-weights (weights (accept::model-path kind))
    (let* ((model (local:load-model weights)) (tokenizer (local:load-tokenizer weights))
           (base (local:encode tokenizer "The capital of France is"))
           (prompt (loop for i below 128 collect (aref base (mod i (length base)))))
           (cache (local:make-kv-cache 136)) (session (local:make-session model :n-ctx 136))
           (expected (tests::greedy-continuation model prompt 4)))
      (unwind-protect
           (progn
             (assert (equal expected '(9625 374 785 6722)))
             (format t "~&VERIFY,~A,~{~D~^;~}~%" kind expected)
             (local:model-forward model prompt :cache cache)
             (measure :prefill kind (lambda () (local:model-forward model prompt)))
             (measure :decode kind (lambda () (local:model-forward model (list (first expected)) :start 128 :cache cache)))
             (measure :generate kind
                      (lambda ()
                        (multiple-value-bind (text finish ids) (local:generate session prompt :max-tokens 4 :timeout 3600000)
                          (declare (ignore text))
                          (assert (and (eq finish :length) (equal ids expected))) ids))
                      (lambda () (local:session-reset session))))
        (local:close-session session)
        (local:close-cache cache)))))
