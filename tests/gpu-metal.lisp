(in-package #:cl-tensor/gpu/tests)
(in-suite :cl-tensor/gpu/metal)

(defun host-values (tensor) (cl-tensor/tests::tensor-values tensor))

(defun same-values-p (expected actual)
  (and (equalp (ct:tensor-shape expected) (ct:tensor-shape actual))
       (eq (ct:tensor-dtype expected) (ct:tensor-dtype actual))
       (every (lambda (x y)
                (if (eq (ct:tensor-dtype expected) :s64) (= x y)
                    (<= (abs (- x y)) (* 1d-4 (max 1d0 (abs x) (abs y))))))
              (host-values expected) (host-values actual))))

(defun mirror-view (cpu storage)
  (ct:make-tensor-view storage (ct:tensor-shape cpu) :dtype (ct:tensor-dtype cpu)
                       :strides (ct:tensor-strides cpu) :offset (ct:tensor-offset cpu)))

(defparameter *gpu-operations*
  '(ct:sum ct:mean ct:prod ct:minimum ct:maximum ct:argmin ct:argmax ct:softmax ct:rmsnorm))

(defun out-operation (operation)
  (symbol-function (find-symbol (format nil "~A!" operation) :cl-tensor)))

(defvar *forbid-download* nil)
(defmethod gpu:device-load :before ((device cl-gpu/metal::metal-device) buffer sequence type offset)
  (declare (ignore buffer sequence type offset))
  (when *forbid-download* (error "Unexpected host download during GPU computation")))

(test metal-operations-match-cpu-for-layouts-and-axis-sets
  (let ((base (ct:from-data (loop for i below 120 collect (+ 0.8f0 (* 0.02f0 (mod i 13)))))))
    (tg:with-device-tensor (device-base (tg:to-device base))
      (dolist (layout '(((2 3 4) (12 4 1) 0)
                        ((4 2 3) (1 12 4) 0)
                        ((2 3 4) (12 -4 1) 8)
                        ((2 3 4) (40 8 2) 3)
                        ((2 3 4) (0 4 1) 0)))
        (destructuring-bind (shape strides offset) layout
          (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) shape :strides strides :offset offset))
                 (input (mirror-view cpu (ct:tensor-storage device-base))))
            (dolist (axis '(nil -1 (2 0) #(2 0) #()))
              (dolist (operation *gpu-operations*)
                (dolist (keepdims (if (member operation '(ct:softmax ct:rmsnorm)) '(nil) '(nil t)))
                  (let* ((options (append (list :axis axis)
                                          (unless (member operation '(ct:softmax ct:rmsnorm))
                                            (list :keepdims keepdims))))
                         (expected (apply operation cpu options)))
                    (tg:with-device-tensor (result (let ((*forbid-download* t)) (apply operation input options)))
                      (is (same-values-p expected (tg:from-device result))
                          "~A axis ~S keepdims ~S layout ~S" operation axis keepdims layout))
                    (let* ((size (ct:tensor-size expected))
                           (shape (ct:tensor-shape expected))
                           (strides (map 'vector (lambda (s) (* -2 s)) (ct:row-major-strides shape))))
                      (tg:with-device-tensor (backing (tg:make-device-tensor (list (+ 2 (* 2 size)))
                                                                            :dtype (ct:tensor-dtype expected)))
                        (let ((out (ct:make-tensor-view (ct:tensor-storage backing) shape
                                                        :dtype (ct:tensor-dtype expected)
                                                        :strides strides :offset (max 0 (* 2 (1- size))))))
                          (is (eq out (let ((*forbid-download* t))
                                        (apply (out-operation operation) out input options))))
                          (is (same-values-p expected (tg:from-device out))))))))))))))))

(test metal-copy-and-reshape-stay-on-device
  (dolist (dtype '(:f32 :s64))
    (let ((base (ct:from-data (if (eq dtype :s64)
                                 '(9223372036854775807 -9223372036854775808 3 4 5 6)
                                 '(1 2 3 4 5 6)) :dtype dtype)))
      (tg:with-device-tensor (device-base (tg:to-device base))
        (let* ((cpu (ct:make-tensor-view (ct:tensor-storage base) '(2 3) :dtype dtype
                                        :strides '(3 -1) :offset 2))
               (input (mirror-view cpu (ct:tensor-storage device-base))))
          (is (same-values-p (ct:copy-tensor cpu) (tg:from-device input)))
          (tg:with-device-tensor (copy (let ((*forbid-download* t)) (ct:copy-tensor input)))
            (is (same-values-p (ct:copy-tensor cpu) (tg:from-device copy))))
          (tg:with-device-tensor (flat (let ((*forbid-download* t))
                                        (ct:reshape (ct:transpose input) '(6) :copy :always)))
            (is (same-values-p (ct:reshape (ct:transpose cpu) '(6) :copy :always)
                               (tg:from-device flat))))
          (let ((out (ct:make-tensor-view (ct:tensor-storage device-base) '(2 3) :dtype dtype)))
            (let ((*forbid-download* t)) (ct:copy-storage! (ct:find-dtype dtype) out input))
            (is (same-values-p cpu (tg:from-device out)))))))))

(test metal-normalization-weights-and-aliases
  (let* ((cpu (ct:from-data '((1 2 3) (4 5 6))))
         (weights (ct:from-data '(1 2 3))))
    (tg:with-device-tensor (input (tg:to-device cpu))
      (tg:with-device-tensor (device-weights (tg:to-device weights))
        (dolist (axis '(nil -1 #()))
          (dolist (weight (list nil 0 2f0 device-weights))
            (let ((host-weight (if (ct:tensorp weight) weights weight)))
              (tg:with-device-tensor (result (let ((*forbid-download* t))
                                              (ct:rmsnorm input :axis axis :weights weight :epsilon 0)))
                (is (same-values-p (ct:rmsnorm cpu :axis axis :weights host-weight :epsilon 0)
                                   (tg:from-device result)))))))
        (let* ((reversed (ct:make-tensor-view (ct:tensor-storage device-weights) '(3) :strides '(-1) :offset 2))
               (host-reversed (ct:make-tensor-view (ct:tensor-storage weights) '(3) :strides '(-1) :offset 2)))
          (tg:with-device-tensor (result (ct:rmsnorm input :weights reversed))
            (is (same-values-p (ct:rmsnorm cpu :weights host-reversed) (tg:from-device result)))))
        (let ((expected (ct:rmsnorm cpu :weights weights)))
          (let ((*forbid-download* t)) (is (eq input (ct:rmsnorm! input input :weights device-weights))))
          (is (same-values-p expected (tg:from-device input))))))
    (dolist (operation '(ct:softmax ct:rmsnorm))
      (tg:with-device-tensor (base (tg:to-device (ct:from-data '(1 2 3 4 5 6 0 0 0))))
        (let* ((storage (ct:tensor-storage base))
               (input (ct:make-tensor-view storage '(2 3)))
               (out (ct:make-tensor-view storage '(2 3) :offset 3))
               (weights (ct:make-tensor-view storage '(3) :offset 3))
               (options (when (eq operation 'ct:rmsnorm) (list :weights weights)))
               (host-options (when options (list :weights (ct:from-data '(4 5 6)))))
               (expected (apply operation cpu host-options)))
          (let ((*forbid-download* t)) (apply (out-operation operation) out input options))
          (is (same-values-p expected (tg:from-device out))))))))

(test metal-reduction-overlap-ties-and-window-offsets
  (let ((cpu (ct:from-data '((3 3 1) (1 2 1)))))
    (tg:with-device-tensor (base (tg:to-device (ct:from-data '(99 99 3 3 1 1 2 1 99))))
      (let* ((window (gpu:make-gpu-array-view (ct:tensor-storage base) 6 :offset 2))
             (input (ct:make-tensor-view window '(2 3))))
        (dolist (operation '(ct:argmin ct:argmax ct:sum))
          (tg:with-device-tensor (result (funcall operation input :axis 1))
            (is (same-values-p (funcall operation cpu :axis 1) (tg:from-device result)))))
        (let ((out (ct:make-tensor-view window '(2) :strides '(-2) :offset 2)))
          (ct:sum! out input :axis 1)
          (is (same-values-p (ct:sum cpu :axis 1) (tg:from-device out))))))))

(test metal-empty-scalar-and-validation
  (dolist (shape '(() (0 3) (2 0 3)))
    (let ((cpu (ct:full shape 2)))
      (tg:with-device-tensor (input (tg:to-device cpu))
        (dolist (operation *gpu-operations*)
          (dolist (axis (if shape '(#()) '(nil #())))
            (tg:with-device-tensor (result (funcall operation input :axis axis))
              (is (same-values-p (funcall operation cpu :axis axis) (tg:from-device result)))))))))
  (tg:with-device-tensor (input (tg:make-device-tensor '(2 0)))
    (dolist (operation '(ct:sum ct:prod))
      (tg:with-device-tensor (result (funcall operation input :axis 1))
        (is (same-values-p (funcall operation (ct:zeros '(2 0)) :axis 1) (tg:from-device result)))))
    (dolist (operation '(ct:mean ct:minimum ct:maximum ct:argmin ct:argmax))
      (signals error (funcall operation input :axis 1))))
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '((1 2 3) (4 5 6)))))
    (tg:with-device-tensor (out (tg:to-device (ct:from-data '(77 88))))
      (let ((before (host-values (tg:from-device out))))
        (signals error (ct:sum! out input :axis 1 :accumulate :f64))
        (is (equal before (host-values (tg:from-device out))))
        (signals error (ct:sum! out input :axis 0))
        (is (equal before (host-values (tg:from-device out))))
        (signals error (ct:sum! (ct:make-tensor-view (ct:tensor-storage out) '(2) :strides '(0)) input :axis 1))
        (is (equal before (host-values (tg:from-device out))))))))
