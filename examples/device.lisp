(require :asdf)
(asdf:load-system "cl-tensor/gpu")
(asdf:load-system "cl-gpu/metal")

(defpackage #:cl-tensor/device-example
  (:use #:cl)
  (:local-nicknames (#:ct #:cl-tensor) (#:tg #:cl-tensor/gpu))
  (:export #:run-example))

(in-package #:cl-tensor/device-example)

(defun run-example ()
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '((1 2 3) (4 5 6)))))
    (tg:with-device-tensor (weights (tg:to-device (ct:from-data '(1 2 3))))
      (tg:with-device-tensor (sum (ct:sum input :axis 1))
        (tg:with-device-tensor (softmax (ct:softmax input))
          (tg:with-device-tensor (normalized (ct:rmsnorm input :weights weights))
            (tg:with-device-tensor (product (ct:matmul input weights))
              (tg:with-device-tensor (dot (ct:matmul weights weights))
                (list :matmul (ct:tensor-storage (tg:from-device product))
                      :dot (ct:tref (tg:from-device dot))
                      :sum (ct:tensor-storage (tg:from-device sum))
                      :softmax (ct:tensor-storage (tg:from-device softmax))
                      :rmsnorm (ct:tensor-storage (tg:from-device normalized)))))))))))

(defun run-elementwise-example ()
  (tg:with-device-tensor (input (tg:to-device (ct:from-data '((1) (2)))))
    (tg:with-device-tensor (bias (tg:to-device (ct:from-data '(0 1 2))))
      (tg:with-device-tensor (sum (ct:add input bias))
        (tg:with-device-tensor (mask (ct:compare :gt sum 2))
          (tg:with-device-tensor (selected (ct:select mask sum 0))
            (tg:with-device-tensor (integer (ct:astype selected :s16))
              (tg:with-device-tensor (encoded (ct:astype selected :bf16))
                (tg:with-device-tensor (decoded (ct:dequantize encoded))
                  (list :integers (ct:tensor-storage (tg:from-device integer))
                        :decoded (ct:tensor-storage (tg:from-device decoded))))))))))))

(format t "~S~%" (run-example))

(format t "~S~%" (run-elementwise-example))
